---
/**
 * / · Sheet A-000 · OWNER: WP3 (composes; WP2 owns CoverSheet). P0 minimal: CoverSheet stub + DrawingIndex stub.
 */
import Base from '../layouts/Base.astro';
import CoverSheet from '../components/home/CoverSheet.astro';
import DrawingIndex from '../components/home/DrawingIndex.astro';
import { home, links } from '../content/site';
import { chrome } from '../data/chrome';
import { stripHtml } from '../lib/text';
import type { PageMeta } from '../lib/page';

const page: PageMeta = { kind: 'home', sheet: 'A-000', sheetTitle: chrome.wp1.titleBar.coverSheet };
const description = stripHtml(home.headline);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: chrome.p0.person,
  url: 'https://www.saumya-verma.com/',
  jobTitle: chrome.p0.jobTitle,
  worksFor: { '@type': 'Organization', name: 'Fulcrum GT' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Maryland, College Park' },
    { '@type': 'CollegeOrUniversity', name: 'NIT Bhopal' },
  ],
  sameAs: [links.linkedin],
};
---
<Base
  title={`${chrome.p0.person} — ${chrome.p0.jobTitle}`}
  description={description}
  page={page}
  canonicalPath="/"
  ogImage="/media/ynF3JX3AYbXmF5u4ZKwl04aGc.png"
  jsonLd={person}
>
  <CoverSheet />
  <DrawingIndex />
</Base>
