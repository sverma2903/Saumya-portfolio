---
/**
 * /fun · Sheet C-100 · OWNER: WP6 (SPEC §5.4).
 *   PlayHeader  C-100 ─── PLAY · her headline ✦ · her sub-line
 *   PinBoard    her five items, in her order, pinned as prints on their own stages (two rows on the 12-column grid)
 *   Crossword   LEGEND · DATA / DESIGN / NERDS — her tile grid as the sheet's legend: the grid, its WORDS and
 *               MATERIALS keys, and Re-lay tiles
 * then the End sheet ("I'd love to connect with you!", Base). LCP = ExpressLanes (§7.2), preloaded.
 */
import Base from '../layouts/Base.astro';
import PlayHeader from '../components/play/PlayHeader.astro';
import PinBoard from '../components/play/PinBoard.astro';
import Crossword from '../components/play/Crossword.astro';
import { play } from '../content/site';
import { chrome } from '../data/chrome';
import type { PageMeta } from '../lib/page';

const page: PageMeta = { kind: 'play', sheet: 'C-100', sheetTitle: chrome.wp1.titleBar.play };
const lcp = play.items[1].media[0].src; // ExpressLanes (§7.2)
---
<Base
  title={`${chrome.wp1.titleBar.play} — ${chrome.p0.person}`}
  description={play.sub}
  page={page}
  canonicalPath="/fun"
  ogImage={lcp}
  lcpImage={lcp}
>
  <PlayHeader />
  <PinBoard />
  <Crossword />
</Base>
