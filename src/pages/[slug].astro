---
/**
 * /cloudflare … /educademy · Sheets A-101…A-106 · WP5 (SPEC §5.2).
 * Order: CaseHeader (the 6-second layer) → KeyPlan + DecisionSchedule (the 60-second layer) → CaseBody (the Levels
 * rail + her chapters, SM4/SM5) → MatchLineNext → the End sheet ("Let's build the next one together!", Base).
 * One module (scripts/case/index.ts) drives Levels, Plan view and citations; it is rendered after the article so no
 * <script> ever sits between two blocks (the §6.1 rhythm is sibling-based).
 */
import Base from '../layouts/Base.astro';
import CaseHeader from '../components/case/CaseHeader.astro';
import KeyPlan from '../components/case/KeyPlan.astro';
import DecisionSchedule from '../components/case/DecisionSchedule.astro';
import CaseBody from '../components/case/CaseBody.astro';
import MatchLineNext from '../components/case/MatchLineNext.astro';
import { cases } from '../content/site';
import { caseLd, ogImageAlt, ogImagePath } from '../lib/seo';
import { COVERS, accentStyle, deckOf, nextCase, sheetBySlug } from '../data/sheets';
import { chrome } from '../data/chrome';
import { chapterCtxs } from '../lib/blocks-ctx';
import { keyplan } from '../lib/keyplan';
import { reading } from '../lib/reading';
import { srcOf } from '../lib/staging';
import type { CaseStudy } from '../lib/blocks';
import type { CaseSlug } from '../lib/verbatim';
import type { PageMeta } from '../lib/page';

export function getStaticPaths() {
  return cases.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}
interface Props { cs: CaseStudy }
const { cs } = Astro.props;
const slug = cs.slug as CaseSlug;
const sheet = sheetBySlug(slug);
const r = reading(cs);
const deck = deckOf(slug);
const next = sheetBySlug(nextCase(slug));
const cover = COVERS[slug];
// the preloaded image is the layer the browser takes as the LCP: the largest on screen (the least inset), which for
// Orbit's two-layer cover is the full-width backdrop, not the laptop above it (that one is already fetchpriority=high
// in Plate, so both halves of the cover load first). WP7: unpreloaded, the backdrop was only requested after layout.
const lcpLayer = cover.layers.reduce((a, l) => ((l.pad ?? 0) <= (a.pad ?? 0) ? l : a));
const lcp = srcOf(lcpLayer.file);
const chapters = chapterCtxs(cs, sheet.no);
const stops = keyplan(cs);
const page: PageMeta = {
  kind: 'case', sheet: sheet.no, sheetTitle: cs.title, sheetTitleIsHers: true, slug,
  levels: r.sections.map((s) => ({ id: s.id, label: s.label, elev: s.elev, minutes: s.minutes })),
  next: { href: next.href, sheet: next.no, title: next.title.text },
};
const jsonLd = caseLd({ slug, title: cs.title, metaTitle: cs.metaTitle, description: deck.text });
---
<Base
  title={`${cs.metaTitle} — ${chrome.p0.person}`}
  description={deck.text}
  page={page}
  canonicalPath={`/${slug}`}
  ogType="article"
  ogImage={ogImagePath(slug)}
  ogImageAlt={ogImageAlt(slug)}
  lcpImage={lcp}
  accentStyle={accentStyle(slug)}
  jsonLd={jsonLd}
>
  <article class="case" data-case={slug}>
    <CaseHeader cs={cs} sheetNo={sheet.no} reading={r} deck={deck.text} cover={cover} />
    <KeyPlan stops={stops} seconds={r.sections.map((s) => s.sec)} sheetNo={sheet.no} minutes={r.minutes} />
    <DecisionSchedule cs={cs} />
    <CaseBody cs={cs} chapters={chapters} reading={r} sheetNo={sheet.no} next={{ href: next.href, no: next.no, title: next.title.text }} />
    <MatchLineNext next={next} />
  </article>
  <script>
    import '../scripts/case/index';
  </script>
</Base>

