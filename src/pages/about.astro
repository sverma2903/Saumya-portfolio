---
/**
 * /about · Sheet B-100 · OWNER: WP6. P0 minimal: header + portrait, story, the four loves.
 */
import Base from '../layouts/Base.astro';
import AboutHeader from '../components/about/AboutHeader.astro';
import Story from '../components/about/Story.astro';
import Shelf from '../components/about/Shelf.astro';
import Writing from '../components/about/Writing.astro';
import Meditation from '../components/about/Meditation.astro';
import Salon from '../components/about/Salon.astro';
import { about, labels, links } from '../content/site';
import { chrome } from '../data/chrome';
import { stripHtml } from '../lib/text';
import type { PageMeta } from '../lib/page';

const page: PageMeta = { kind: 'about', sheet: 'B-100', sheetTitle: chrome.wp1.titleBar.about };
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: chrome.p0.person, url: 'https://www.saumya-verma.com/',
  jobTitle: chrome.p0.jobTitle, worksFor: { '@type': 'Organization', name: 'Fulcrum GT' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Maryland, College Park' },
    { '@type': 'CollegeOrUniversity', name: 'NIT Bhopal' },
  ],
  sameAs: [links.linkedin],
};
---
<Base
  title={`${chrome.wp1.titleBar.about} — ${chrome.p0.person}`}
  description={stripHtml(about.headline)}
  page={page}
  canonicalPath="/about"
  ogImage={about.portrait.src}
  lcpImage={about.portrait.src}
  jsonLd={person}
>
  <AboutHeader />
  <Story />
  <section class="loves shell" aria-labelledby="loves-h">
    <h2 id="loves-h" class="t-label-lg" data-v>{labels.loves}</h2>
    <div class="loves__list">
      <Shelf />
      <Writing />
      <Meditation />
      <Salon />
    </div>
  </section>
</Base>
<style>
  .loves { padding-block: var(--s-7); }
  .loves__list { display: grid; gap: var(--s-8); margin-block-start: var(--s-5); }
</style>
