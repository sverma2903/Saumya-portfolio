---
/**
 * /about · Sheet B-100 · OWNER: WP6 (SPEC §5.3).
 *   AboutHeader   B-100 ─── ABOUT · her headline · Architecture Portfolio ↗ · her portrait with its compass construction
 *   Story         "My Story ↓" · her three paragraphs as clauses B-100.1–.3
 *   Things I love "Things I love ↓" · four details, bubbles 1–4 / B-100:
 *                 Historical Fiction (the shelf) · Blog & Writing (the reference list) · Meditation (the still field) ·
 *                 Sketching (the salon)
 * then the End sheet ("I'd love to connect with you!", Base). LCP = the portrait (preloaded, fetchpriority=high).
 */
import Base from '../layouts/Base.astro';
import AboutHeader from '../components/about/AboutHeader.astro';
import Story from '../components/about/Story.astro';
import Section from '../components/about/Section.astro';
import Shelf from '../components/about/Shelf.astro';
import Writing from '../components/about/Writing.astro';
import Meditation from '../components/about/Meditation.astro';
import Salon from '../components/about/Salon.astro';
import { about, labels, links } from '../content/site';
import { chrome } from '../data/chrome';
import { slugify, stripHtml } from '../lib/text';
import type { PageMeta } from '../lib/page';

const page: PageMeta = { kind: 'about', sheet: 'B-100', sheetTitle: chrome.wp1.titleBar.about };
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: chrome.p0.person, url: 'https://www.saumya-verma.com/',
  jobTitle: chrome.p0.jobTitle, worksFor: { '@type': 'Organization', name: 'Fulcrum GT' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Maryland, College Park' },
    { '@type': 'CollegeOrUniversity', name: 'NIT Bhopal' },
  ],
  sameAs: [links.linkedin],
};
---
<Base
  title={`${chrome.wp1.titleBar.about} — ${chrome.p0.person}`}
  description={stripHtml(about.headline)}
  page={page}
  canonicalPath="/about"
  ogImage={about.portrait.src}
  lcpImage={about.portrait.src}
  jsonLd={person}
>
  <AboutHeader />
  <Story />
  <Section id={slugify(labels.loves)} label={labels.loves}>
    <div class="loves">
      <Shelf />
      <Writing />
      <Meditation />
      <Salon />
    </div>
  </Section>
</Base>
<style>
  .loves {
    grid-column: rail-start / notes-end;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--s-10);
  }
  @media (max-width: 1023.98px) {
    .loves { row-gap: var(--s-9); }
  }
</style>
