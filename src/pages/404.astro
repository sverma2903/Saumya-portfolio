    <div class="gl-fallback"></div>
    <canvas class="gl" data-field data-shade="0.3" data-seed="3.1" aria-hidden="true"></canvas>
    <div style="position:relative; z-index:2; padding: 0 16px">
      <p class="mono">Off the drawing board</p>
      <h1>404</h1>
      <p>This page isn't part of the plan.</p>
      <a class="btn light" href="/">Back home <span class="arrow">→</span></a>
    </div>
  </section>
</Base>
