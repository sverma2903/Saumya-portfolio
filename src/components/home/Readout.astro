---
/**
 * Readout · OWNER: WP3 (SPEC SM2). Her real numbers, verbatim, in two settings:
 *
 *  variant="viewport" — the Viewport's readout: numerals in Newsreader Light (tnum) with her labels on the same last
 *                       baseline, the optional verbatim sub-line, and PFF's bars drawn to scale (15 : 6) with her
 *                       caption. (The "Cited from" line is rendered by the Viewport's foot.)
 *  variant="row"      — inside every index row: screen-reader-only at ≥ 1024 (the Viewport is aria-hidden, so the
 *                       rows carry its information), and the card's one-line readout (her first figure) below 1024.
 *
 * Verbatim rules (tests/data/substrings + tests/dist/verbatim): every figure is a VerbatimRef from sheets.ts. A
 * `joined` line renders its value and label as two adjacent spans inside ONE data-v element, so the element's
 * textContent is the exact source run ("Two" + " of the gaps identified…"). Typographic splits never add or remove
 * characters.
 */
import type { Readout as R } from '../../data/sheets';
interface Props {
  readout: R;
  /** 'header' (polish r1): the case header's outcome, under the cover plate — the viewport setting, smaller, with only
   *  the figures in `lines` (those her deck does not already state) and no sub-line */
  variant?: 'viewport' | 'row' | 'header';
  lines?: number[];
  /** P0 compatibility: srOnly === variant "row" */
  srOnly?: boolean;
  /** row variant: the figure the card shows below 1024 (IndexRow picks the first her outcome line does not already
   *  say; -1 = none, the whole readout is for screen readers) */
  show?: number;
}
const { readout, srOnly = false, show = 0 } = Astro.props;
const variant = Astro.props.variant ?? (srOnly ? 'row' : 'viewport');
const header = variant === 'header';
const figs = Astro.props.lines ? readout.lines.filter((_, i) => Astro.props.lines!.includes(i)) : readout.lines;
const pair = figs.length > 1;
const bars = readout.bars;
const toRatio = bars ? bars.ratio[1] / bars.ratio[0] : 0;
---
{variant === 'row' ? (
  <span class="rdr">
    {readout.lines.map((l, i) =>
      l.joined ? (
        <span class:list={['rdr__line', { 'rdr__line--more': i !== show }]} data-v><span class="rdr__v">{l.value.text}</span><span class="rdr__l">{l.label.text}</span></span>
      ) : (
        <span class:list={['rdr__line', { 'rdr__line--more': i !== show }]}><span class="rdr__v" data-v>{l.value.text}</span> <span class="rdr__l" data-v>{l.label.text}</span></span>
      ),
    )}
    {readout.sub && <span class="rdr__more" data-v>{readout.sub.text}</span>}
    {bars && <span class="rdr__more" data-v>{bars.caption.text}</span>}
  </span>
) : (
  <div class:list={['rd', { 'rd--pair': pair, 'rd--bars': !!bars, 'rd--header': header }]}>
    <div class="rd__figs">
      {figs.map((l) =>
        l.joined ? (
          <p class="rd__fig" data-v><span class="rd__v">{l.value.text}</span><span class="rd__l">{l.label.text}</span></p>
        ) : (
          <p class="rd__fig"><span class="rd__v" data-v>{l.value.text}</span> <span class="rd__l" data-v>{l.label.text}</span></p>
        ),
      )}
    </div>
    {bars && (
      <div class="rd__bars" style={`--_to: ${toRatio}`}>
        <span class="rd__track rd__track--from" aria-hidden="true" data-hatch></span><p class="rd__bl rd__bl--from" data-v>{bars.from.text}</p>
        <p class="rd__bar rd__bar--to"><span class="rd__track" aria-hidden="true"></span><span class="rd__bl" data-v>{bars.to.text}</span></p>
        <p class="rd__cap" data-v>{bars.caption.text}</p>
      </div>
    )}
    {readout.sub && !header && <p class="rd__sub" data-v>{readout.sub.text}</p>}
  </div>
)}

<style>
  /* ─────────────── row / card variant ─────────────── */
  .rdr { display: block; }
  .rdr__line, .rdr__more { display: block; }
  /* ≥ 1024: the whole readout is for screen readers only (the Viewport shows it) */
  @media (min-width: 1024px) {
    .rdr {
      position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
    }
  }
  /* < 1024: the card's readout is one figure, set as one run: the numeral (a stat) and her label follow each other on
     the line, and a label that wraps runs back under the numeral, never down a narrow column beside it. Every card
     sets it the same way. The rest stays for screen readers. */
  @media (max-width: 1023.98px) {
    .rdr__line--more, .rdr__more {
      position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
    }
    .rdr__line { font-size: var(--fs-body-sm); line-height: var(--lh-body-sm); color: var(--ink-2); text-wrap: pretty; }
    .rdr__v {
      font-size: var(--fs-stat); font-weight: var(--wt-stat); line-height: var(--lh-stat);
      letter-spacing: var(--tr-stat); font-variant-numeric: tabular-nums; color: var(--ink);
      margin-inline-end: var(--s-2); white-space: nowrap;
    }
  }

  /* ─────────────── viewport variant ─────────────── */
  /* the numerals' 0.95 line box leaves no air over their caps: the readout takes --s-2 more above, so the room over
     the numeral matches the room under the labels (to the foot) */
  .rd { display: grid; row-gap: var(--s-3); padding-block-start: var(--s-2); }
  .rd__figs { display: grid; gap: var(--s-2) var(--s-6); }
  .rd__fig {
    display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--s-4); align-items: last baseline;
    font-size: var(--fs-body); line-height: var(--lh-body-sm); color: var(--ink-2); text-wrap: pretty;
  }
  .rd__v {
    font-size: var(--fs-readout); font-weight: var(--wt-readout); line-height: var(--lh-readout);
    letter-spacing: var(--tr-readout); font-variant-numeric: tabular-nums; color: var(--ink);
    white-space: nowrap;
  }
  .rd__l { max-inline-size: calc(var(--measure) * 0.55); }
  /* two figures (A-103, A-105): side by side, each numeral over its label */
  .rd--pair .rd__figs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .rd--pair .rd__fig { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-1); align-items: start; font-size: var(--fs-body-sm); }
  /* two numerals share the width: each is set at --fs-stat, so "~ 600 K" stays inside its half at 1024–1440 */
  .rd--pair .rd__v { font-size: var(--fs-stat); }

  .rd__sub {
    font-size: var(--fs-body-sm); line-height: var(--lh-body-sm); color: var(--ink-2);
    padding-inline-start: var(--s-3); border-inline-start: var(--lw-border) solid var(--line-2);
    max-inline-size: calc(var(--measure) * 0.6);
  }

  /* A-102: 15 minutes → ~6 minutes, drawn to scale (graphite hatch = before, rust = after), as a drawing with a
     note column. Both tracks measure against the same column (1), so the ratio holds exactly (the rust track is
     --_to of it); the "15 minutes" label and her caption share the note column (2), on one left edge, the caption
     on the rust bar's line; "~6 minutes" follows its own short bar. */
  .rd__bars {
    display: grid; grid-template-columns: minmax(0, 1fr) max-content; align-items: center; gap: var(--s-1) var(--s-3);
  }
  .rd__bar { display: flex; align-items: center; gap: var(--s-3); }
  .rd__bl, .rd__cap { font-size: var(--fs-body-sm); line-height: var(--lh-label); color: var(--ink-2); }
  .rd__track { flex: none; display: block; block-size: var(--s-2); }
  .rd__track--from { background: var(--hatch-45); box-shadow: inset 0 0 0 var(--lw-object) var(--line-3); }
  .rd__bar--to .rd__track { inline-size: calc(100% * var(--_to)); background: var(--rust); }
  .rd__bar--to .rd__bl { color: var(--rust); }
  .rd__cap { font-style: italic; font-size: var(--fs-caption); }
  /* the case header's outcome (polish r1): the same drawing a step smaller, under a hairline, beside the cover */
  .rd--header { padding-block-start: var(--s-4); border-block-start: var(--lw-object) solid var(--line-2); }
  .rd--header .rd__v, .rd--header.rd--pair .rd__v { font-size: var(--fs-stat); line-height: var(--lh-stat); }
  .rd--header .rd__fig { font-size: var(--fs-body-sm); }
  .rd--header .rd__l { max-inline-size: calc(var(--measure) * 0.6); }
  @media (forced-colors: active) {
    .rd__track { forced-color-adjust: none; }
    .rd__track--from { background: none; box-shadow: inset 0 0 0 1px CanvasText; }
    .rd__bar--to .rd__track { background: CanvasText; }
  }
</style>
