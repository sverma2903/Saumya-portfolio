---
/**
 * CoverSheet · OWNER: WP2 (SPEC SM1, §5.1). Sheet A-000: her headline (the LCP, painted at first paint) beside a live
 * site plan of her △○□ and its coordinated Section A–A, drawn by scripts/hero/siteplan.ts (WebGL2 plan + Canvas2D
 * section) and settling to a stop; SitePlanFallback (generated by tools/siteplan-svg.mjs) is the static drawing for
 * no JS / no WebGL2 / reduced motion / Motion off / Save-Data / low memory, print and forced colours.
 *
 * Layout (SPEC SM1 "Layout per breakpoint"): ≥ 1024 the cover is clamp(620px, 100svh − bar − 144px, 820px) tall, text in
 * cols 1–5 (set low, its CTA row centred on the section legend row: one line shared across the sheet), plan in cols 6–12 from 8% to 64% of the height, section from 70% to 86%; the GL frame
 * covers the whole cover (contours at 28% under the headline). Below 1024 the text comes first and the frame covers the
 * drawing block only (plan 1.6 : 1 on tablets, 1 : 1 up to 420px on phones; section 130 / 120px).
 * The headline sets in five lines at ≥ 1024: font-size = min(--fs-cover, --_fs-fit = 11.4cqi of the text column). At 1440 × 900 the
 * token's 76px would need six lines in cols 1–5 and push the index below the fold; 11.4cqi is the measure at which her
 * 87-character headline balances into five (measured), ≈ 61px at 1440, 67px at ≥ 1600.
 *
 * No flash: the head script sets html[data-gl=maybe] only when WebGL2 exists, motion is on and Save-Data is off; the
 * fallback is hidden under maybe/live, the canvases under anything else. siteplan.ts sets 'live' after its first
 * frame, 'no' on failure. The head script only knows the interface exists (WebGL can still be disabled or blocklisted),
 * so the tiny inline probe right after the GL canvas asks for the context during parse — before first paint — and
 * resolves 'maybe' → 'no' at once when there is none (the static drawing is then the first thing painted, however late
 * the module arrives). Trade-off: the context is created during parse, after the h1, instead of when the module runs
 * (the same work, moved earlier; siteplan.ts gets the same context back). The inline guard at the end shows the
 * fallback if the hero module never ran.
 */
import { home, labels, links } from '../../content/site';
import { chrome, narrative } from '../../data/chrome';
import type { SheetNo } from '../../data/sheets';
import Ornament from '../symbols/Ornament.astro';
import Bubble from '../symbols/Bubble.astro';
import SitePlanFallback from './SitePlanFallback.astro';

const SHEET: SheetNo = 'A-000';
const h = chrome.wp2.hero;
/** 'Site plan · move to cut A–A' → ['Site plan', 'move to cut', 'A–A'] (our own chrome, split to colour the cut rust) */
const parts = (s: string) => {
  const [site, act = ''] = s.split(' · ');
  const i = act.lastIndexOf(' ');
  return { site, verb: act.slice(0, i), cut: act.slice(i + 1) };
};
const hp = parts(h.planHintPointer);
const ht = parts(h.planHintTouch);
/** the plan's accessible name: the owner-gated sentence (N) once approved; until then two shipped labels, no pointer talk */
const planName = narrative(h.planLabel) ?? `${hp.site} · ${h.section}`;
/** Her headline and sub, verbatim. The only change is typographic: her compounds "AI-assisted" and "front-end" may not
 *  break at their hyphens, and her italic "product designer" is never split across lines (text-wrap: balance did so at
 *  768–1023) — a nowrap span around the run; the text — and every test's view of it — is unchanged. */
const nb = (html: string, word: string) => html.replace(word, `<span class="cover__nb">${word}</span>`);
const headline = nb(nb(home.headline, 'AI-assisted'), '<em>product designer</em>');
const sub = nb(home.sub, 'front-end');
---
<section class="cover" id="cover" aria-labelledby="cover-h" data-cover data-el={h.el} data-north={h.north}>
  <div class="cover__text" data-text>
    <p class="cover__eyebrow t-label-lg"><span class="cover__sheet t-code">{SHEET}</span><span class="cover__rule" aria-hidden="true"></span><span>{h.coverSheet}</span></p>
    <h1 id="cover-h" class="cover__h" data-v><Fragment set:html={headline} /> <Ornament /></h1>
    <p class="cover__sub" data-v set:html={sub} />
    <p class="cover__ctas">
      <a class="btn cover__btn" href="#index" data-v>{labels.selected}</a>
      <a class="cover__connect" href={links.email} data-v>{home.connect}</a>
    </p>
  </div>

  <div class="cover__drawing">
    <p class="cover__hint t-label" aria-hidden="true">
      <span>{hp.site}</span><span class="cover__act"><span class="cover__dot"> · </span><span class="cover__verb--p">{hp.verb}</span><span class="cover__verb--t">{ht.verb}</span> <span class="rust">{hp.cut}</span></span>
    </p>
    <div class="cover__plan" role="img" aria-label={planName} data-plan data-roledesc={h.planRole}></div>
    <p class="sr-only" id="cover-plan-keys" data-plan-keys hidden>{h.planKeys}</p>
    <p class="sr-only" role="status" aria-live="polite" data-plan-status></p>
    <div class="cover__sect" data-sect></div>
    <div class="cover__legend" aria-hidden="true" data-legend>
      <Bubble n="1" sheet={SHEET} />
      <p class="cover__legend-t"><span class="t-label-lg">{h.section}</span><span class="t-label">{h.scale}</span></p>
    </div>
    <div class="cover__fallback"><SitePlanFallback /></div>
  </div>

  <div class="cover__gl" aria-hidden="true" data-frame>
    <canvas class="cover__cv" data-gl-canvas></canvas>
    <!-- the parse-time WebGL2 probe (Deviation 20) stands down while a view transition reveals this page: Chromium drops
         the cut when a context is created then (integration); siteplan.ts creates it once the cut has finished -->
    <script is:inline>(function(c,d){var t=0;try{t=d.matches(':active-view-transition')}catch(e){}if(!t&&d.dataset.gl==='maybe'&&!c.getContext('webgl2',{alpha:true,premultipliedAlpha:true,antialias:false,depth:false,stencil:false,preserveDrawingBuffer:false,powerPreference:'low-power'})){d.dataset.gl='no';c.closest('[data-cover]').dataset.heroFail='no WebGL2 context'}})(document.currentScript.previousElementSibling,document.documentElement)</script>
    <canvas class="cover__cv" data-ov-canvas></canvas>
  </div>
</section>
<script is:inline>addEventListener('load',function(){setTimeout(function(){var d=document.documentElement;if(d.dataset.gl==='maybe'&&!document.querySelector('[data-hero]'))d.dataset.gl='no'},4e3)})</script>
<script>
  import { initSitePlan } from '../../scripts/hero/siteplan';
  initSitePlan();
</script>

<style>
  /* ── base (phones first): text, then the drawing block; the GL frame covers the drawing block, bleeding to the edges ── */
  .cover {
    /* SM1's 100svh − bar − 140px, less 4px of the cover's own bottom air (integration): the index header, its first
       strip, the A-101 title and BOTH lines of its outcome then end above the fold at 1440 × 900 and 1536 × 864 (at
       140px the second line's descenders crossed it by 2px; WP3 notes, deviation 2). */
    /* polish r1: the cover leaves 200px of the first screen to the index (its own --s-6 of air, the header, the first
       strip, A-101's title and outcome, the top of its plate), where it left 144px with the index header crowded on
       the cover's edge; on short windows (≤ 760px) the cover is the first screen, and only the index title shows */
    --_h: clamp(560px, calc(100svh - var(--bar) - 200px), 780px);
    --_gl-gain: 1;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--s-7);
    padding: var(--s-7) var(--m) var(--s-5);
  }
  :global(:root[data-theme='dusk']) .cover { --_gl-gain: 1.3; }

  .cover__text { position: relative; z-index: 1; grid-row: 1; }
  .cover__eyebrow { display: flex; align-items: center; gap: var(--s-3); margin-block-end: var(--s-5); color: var(--ink-2); }
  .cover__sheet { color: var(--rust); }
  .cover__rule { inline-size: var(--s-7); border-block-start: var(--lw-object) solid var(--line-3); }
  .cover__h {
    font-family: var(--font-serif);
    font-size: var(--fs-cover);
    font-weight: var(--wt-cover);
    line-height: var(--lh-cover);
    letter-spacing: var(--tr-cover);
    text-wrap: balance;
  }
  .cover__h :global(.hl) { color: var(--rust-2); }
  .cover :global(.cover__nb) { white-space: nowrap; }
  .cover__sub {
    margin-block-start: var(--s-5);
    max-inline-size: 32em;
    font-size: var(--fs-body-md);
    line-height: var(--lh-body-md);
    color: var(--ink-2);
  }
  .cover__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5); margin-block-start: var(--s-6); }
  @media (pointer: coarse) { .cover__connect { display: inline-flex; align-items: center; min-block-size: var(--hit); } }
  /* the §6.2 CTA hover: the blush hatch slides in (background-position, --dur-3) */
  .cover__btn {
    background-image: linear-gradient(90deg, transparent 50%, var(--sheet) 50%), var(--hatch-blush);
    background-size: 200% 100%, auto;
    background-position: 100% 0, 0 0;
    background-repeat: no-repeat, repeat;
    transition: background-position var(--dur-3) var(--ease-pen), color var(--dur-1) var(--ease-ui);
  }
  .cover__btn:hover { background-position: 0 0, 0 0; }
  /* the secondary action sits under the button's weight: body-sm, its cap height ≈ the button label's */
  .cover__connect {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--ink);
    text-underline-offset: var(--s-1);
  }

  .cover__drawing { position: relative; z-index: 1; grid-row: 2; grid-column: 1; display: grid; grid-template-columns: minmax(0, 1fr); pointer-events: none; }
  .cover__hint { margin-block-end: var(--s-4); color: var(--ink-3); }
  .cover__verb--t { display: none; }
  @media (pointer: coarse) {
    .cover__verb--p { display: none; }
    .cover__verb--t { display: inline; }
  }
  .cover__plan { aspect-ratio: 1; max-block-size: 420px; touch-action: pan-y; }
  .cover__sect { block-size: 120px; margin-block-start: var(--s-6); }
  .cover__legend { display: flex; align-items: center; gap: var(--s-3); margin-block-start: var(--s-4); min-block-size: var(--s-7); }
  .cover__legend-t { display: grid; row-gap: calc(var(--s-1) / 2); }
  .cover__legend-t > :last-child { color: var(--ink-2); }

  .cover__gl { position: relative; z-index: 0; grid-row: 2; grid-column: 1; margin-inline: calc(-1 * var(--m)); pointer-events: none; }
  .cover__cv { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }

  @media (min-width: 768px) {
    .cover__plan { aspect-ratio: 1.6; max-block-size: none; }
    .cover__sect { block-size: 130px; }
  }

  /* ── ≥ 1024: the sheet. Full-bleed frame; a 12-column grid aligned with .shell ── */
  @media (min-width: 1024px) {
    .cover {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--g);
      row-gap: 0;
      padding-block: 0;
      padding-inline: calc(max(0px, (100% - var(--maxw)) / 2) + var(--m));
      min-block-size: var(--_h);
    }
    /* One shared line across the two columns: the CTA row's centre sits on the section legend row's centre (the
       bubble's). The legend row is --s-7 tall from 86% + --s-2 of the cover; the CTA row is --s-7 tall and centred,
       and it ends the text column, so the column ends --s-2 + --s-7 below 86%: padding-end = 14% of the cover − both.
       (The cover is --_h tall whenever its text fits, which is every ≥ 1024 layout; % padding would be of the width.) */
    .cover__text {
      --_fs-fit: 11.4cqi; /* the measure at which her 87-character headline balances into five lines (Deviation 1) */
      grid-column: 1 / span 5; grid-row: 1; align-self: end;
      padding-block: var(--s-7) calc(var(--_h) * 0.14 - var(--s-2) - var(--s-7));
      container-type: inline-size;
    }
    /* …and never taller than the window allows: 7.2svh caps it on laptop-height windows (57px at 790, 52px at 720),
       above ≈ 850px the column's measure is the smaller */
    .cover__h { font-size: min(var(--fs-cover), var(--_fs-fit), 7.2svh); }
    .cover__ctas { min-block-size: var(--s-7); }
    .cover__drawing { grid-column: 6 / span 7; grid-row: 1; display: block; }
    .cover__hint { position: absolute; inset-inline-end: 0; inset-block-start: max(var(--s-3), calc(8% - var(--s-6))); margin: 0; }
    .cover__plan { position: absolute; inset-inline: 0; inset-block: 8% 36%; aspect-ratio: auto; max-block-size: none; }
    .cover__sect { position: absolute; inset-inline: 0; inset-block: 70% 14%; block-size: auto; margin: 0; }
    .cover__legend { position: absolute; inset-inline-start: 0; inset-block-start: calc(86% + var(--s-2)); margin: 0; }
    .cover__gl { position: absolute; inset: 0; margin: 0; grid-row: auto; grid-column: auto; }
    /* the static drawing at the live scale: its plan's top edge (30 canonical px below the drawing's top — the room
       tools/siteplan-svg.mjs leaves for the dome's top rings) on the live plan's (8%); the column is a container, so
       the 30px scales with it as a share of the canonical 764.67px column */
    .cover__drawing { container-type: inline-size; --_spf-top: calc(100cqi * 30 / 764.67); }
    .cover__fallback { position: absolute; inset-inline: 0; inset-block-start: calc(8% - var(--_spf-top)); }
  }

  @media (min-width: 1024px) and (max-height: 820px) {
    .cover__text { padding-block-start: var(--s-5); }
    .cover__eyebrow { margin-block-end: var(--s-4); }
  }
  @media (min-width: 1024px) and (max-height: 760px) {
    .cover { --_h: max(480px, calc(100svh - var(--bar) - var(--s-6) - 40px)); }
  }

  /* ── live vs static: the fallback shows unless the head script (or the hero) says WebGL is on ── */
  .cover__gl, .cover__plan, .cover__sect, .cover__legend, .cover__act { display: none; }
  :global(:root:is([data-gl='maybe'], [data-gl='live'])) .cover__gl { display: block; }
  :global(:root:is([data-gl='maybe'], [data-gl='live'])) :is(.cover__plan, .cover__sect) { display: block; }
  :global(:root:is([data-gl='maybe'], [data-gl='live'])) .cover__legend { display: flex; }
  :global(:root:is([data-gl='maybe'], [data-gl='live'])) .cover__act { display: inline; }
  :global(:root:is([data-gl='maybe'], [data-gl='live'])) .cover__fallback { display: none; }
  /* live: the plan box takes the pointer (crosshair) and the keyboard (focus frame) */
  :global(:root[data-gl='live']) .cover__plan { pointer-events: auto; cursor: crosshair; }
  .cover__plan:focus-visible { outline: var(--lw-cut) solid var(--focus); outline-offset: var(--s-1); }

  @media print {
    .cover__gl, .cover__plan, .cover__sect, .cover__legend, .cover__act { display: none !important; }
    .cover__fallback { display: block !important; }
  }
  @media (forced-colors: active) {
    .cover__gl, .cover__plan, .cover__sect, .cover__legend, .cover__act { display: none !important; }
    .cover__fallback { display: block !important; }
  }
</style>
