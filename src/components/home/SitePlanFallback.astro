---
/**
 * SitePlanFallback · OWNER: WP2 (generated by tools/siteplan-svg.mjs from lib/terrain.js; P0 stub).
 * The static SVG plan + section (contours, rust isoline at +12.00, poché, cut A–A, north arrow, scale bar, leaders),
 * shown with no JS / no WebGL2 / reduced motion / Save-Data (html[data-gl="no"]). aria-hidden.
 * P0: her △○□ mark drawn large, as a placeholder of the right proportions.
 */
import Mark from '../symbols/Mark.astro';
---
<div class="siteplan-fallback" aria-hidden="true">
  <Mark size={240} strokeWidth={0.5} class="ink-2" />
</div>
<style>
  .siteplan-fallback { display: grid; place-items: center; aspect-ratio: 1.6; border: var(--lw-object) solid var(--line-2); background: var(--hatch-45); }
</style>
