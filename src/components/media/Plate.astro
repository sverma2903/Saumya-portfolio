---
/**
 * Plate · WP4b (SPEC §6.3). The box every piece of her media sits in. P0 shipped the minimal version; this is the
 * complete one. Her files are shown byte-for-byte: a plate only FRAMES them (mats, bezels, a browser bar, a stage),
 * never filters, re-encodes, crops (beyond the documented §6.4 exceptions) or covers them at rest.
 *
 * interface PlateProps {
 *   layers: LayerMedia[];       // bottom → top (Orbit: backdrop, laptop); a layer may carry its own pad/fit
 *   stage?: string;             // CSS background (her stage)
 *   aspect?: number;            // box w/h; default = first layer's native aspect
 *   fit?: 'contain' | 'fill';   // 'fill' only for a layer whose native aspect == box aspect
 *   pad?: number;               // % inset for contained layers (stage margin)
 *   frame?: Frame;              // default: media-staging.ts, else 'plate'
 *   vt?: string;                // view-transition-name (on the root)
 *   dims?: boolean;             // hover/focus dimension strings (covers only)
 *   priority?: 'high' | 'auto' | 'lazy';
 *   fig?: { no: string; caption?: string; capId?: string };  // the Enlarged-detail trigger + figure meta
 *   alt: string;                // data/alt.ts; '' only for decorative duplicates
 *   // WP4b additions (all optional; existing callers are unaffected)
 *   controls?: boolean;         // GIF/video controls (default on, except decorative bare plates: alt '' + no fig/dims)
 *   loop?: boolean;             // videos loop as ambient (default); the walkthrough player passes false
 *   managed?: boolean;          // false → the page-wide GIF/video managers leave it to its host (the walkthroughs)
 *   describedBy?: string;       // id of her adjacent text: the recording's text alternative (§7.1, 1.2.1)
 *   zoom?: 'deep' | 'soft';     // overrides the staging zoom (a media block's own `zoom: true` → 'deep': 1:1 emphasised)
 *   class?: string;
 * }
 *
 * DOM (the hooks scripts/media/* and the Enlarged detail read):
 *   .plate[data-plate data-file data-kind data-state data-fig-no data-cap-id data-zoom data-native data-fmt data-size data-src-orig]
 *     [browser → .brw: bar (controls + loop hairline) + view window]
 *     .plate__mat          the frame surround: plate hairline · print border · "before" surround · device bezel
 *       .plate__view       the exact aspect box ([data-ph-host data-state]); stage colour; placeholder, media, poster canvas
 *       button.plate__open [data-fig] the Enlarged-detail trigger over the media
 *     controls · hairline  outside the view (the hover overlay on bare/plain plates is the one exception, per §6.3)
 *   GIFs and videos never carry `src` in the HTML (except the page's LCP plate): the managers mount them from data-src.
 *   Each has a <noscript> twin with a real src.
 */
import type { Media } from '../../lib/blocks';
import type { Frame } from '../../data/media-staging';
import { facts, fileOf, stagingOf } from '../../lib/staging';
import { chrome, fill as fillTpl } from '../../data/chrome';
import { stripHtml } from '../../lib/text';
import { rich } from '../../lib/rich';
import FrameBrowser from './Frame.astro';
import Placeholder from './Placeholder.astro';
import MediaControls from './MediaControls.astro';
import DimString from './DimString.astro';
import Icon from '../symbols/Icon.astro';
import { clock, containRect, enlargeable, factAttrs, kindOf, r4, wantsPlaceholder } from './media-lib';

export type LayerMedia = Media & { pad?: number; fit?: 'contain' | 'fill' };

/** Frames that are a DEVICE around her screen (a bezel, or the clip that removes a baked white canvas). */
const DEVICE_FRAMES: Frame[] = ['phone', 'phone-baked', 'phone-video', 'bezel-dark'];
// ---- device bezels around FLAT screens (phone, bezel-dark) ----
// The ring is padding and the outer corner radius is r% of the device's width. Her screens run content into their
// square corners (PFF's "Reject" button sits in one), so nothing may round or cover them: the ring must be at least
// R·(1 − 1/√2) wide for a square screen corner to clear the rounded outer edge. p = 4.4 ≥ 0.293 × 13 ✓ and
// p = 3.6 ≥ 0.293 × 12 ✓.
const BEZEL: Partial<Record<Frame, { p: number; r: number }>> = { phone: { p: 4.4, r: 13 }, 'bezel-dark': { p: 3.6, r: 12 } };
interface Props {
  layers: LayerMedia[];
  stage?: string;
  aspect?: number;
  fit?: 'contain' | 'fill';
  pad?: number;
  frame?: Frame;
  vt?: string;
  dims?: boolean;
  priority?: 'high' | 'auto' | 'lazy';
  fig?: { no: string; caption?: string; capId?: string };
  alt: string;
  controls?: boolean;
  loop?: boolean;
  managed?: boolean;
  describedBy?: string;
  zoom?: 'deep' | 'soft';
  class?: string;
}
const {
  layers, stage, aspect, fit = 'contain', pad = 0, frame, vt, dims = false, priority = 'lazy', fig, alt,
  loop = true, managed = true, describedBy, zoom, class: cls,
} = Astro.props;

const first = layers[0];
const top = layers[layers.length - 1];
const staged = !!stage || aspect != null || layers.length > 1;
const ft = facts(top);
const stTop = stagingOf(top);
const boxAspect = aspect ?? facts(first).aspect;
// A device frame (a CSS bezel, or the clip that removes the white canvas baked around a phone) belongs to the FILE:
// a caller's generic 'bare' — or no frame at all — never strips it. Any other explicit frame still wins ('browser').
const fileFrame = stTop.frame;
const device: Frame | undefined = fileFrame && DEVICE_FRAMES.includes(fileFrame) ? fileFrame : undefined;
const resolvedFrame: Frame = device && (frame == null || frame === 'bare') ? device : frame ?? stagingOf(first).frame ?? 'plate';
// on a staged plate (her stage around it: Play's pinned plates, a card) the device wraps the LAYER, not the stage box
const devInStage = staged && !!device && resolvedFrame === device;
const matFrame: Frame = devInStage ? 'bare' : resolvedFrame;
const kinds = layers.map((l) => kindOf(l));
const motionKind = kinds.includes('gif') ? 'gif' : kinds.includes('video') ? 'video' : 'image';
const moving = motionKind !== 'image';
const audio = kindOf(top) === 'video' && !!stTop.video?.audio;
const cap = !staged ? stTop.cap : undefined;
const loading = priority === 'lazy' ? 'lazy' : 'eager';
const canEnlarge = !!fig && enlargeable(top);
// every GIF/video carries Pause (WCAG 2.2.2), decorative duplicates included; inside a link or button (a home card)
// plates.ts removes the controls and the managers keep that media still instead (it never loops unstoppably)
const controls = moving && (Astro.props.controls ?? true);
const ctlVariant: 'bar' | 'below' | 'overlay' = matFrame === 'browser' ? 'bar' : matFrame === 'phone-baked' ? 'below' : 'overlay';
const secs = stTop.gif?.secs ?? stTop.video?.secs;
const m = chrome.wp4b.media;
const soundLabel = audio ? fillTpl(m.playSound, { t: clock(secs ?? 0) }) : '';
// its drawn units ("Play", "0:48", "sound"): ▶ draws "Play"; "0:48 · sound" is the line under it (polish r1)
const soundUnits = soundLabel ? soundLabel.split(' · ') : [];

// ---- the view: the exact aspect box (staged: the stage box; natural: the file itself) ----
const viewAspect = staged ? boxAspect : ft.w / ft.h;
const clipBaked = resolvedFrame === 'phone-baked'
  ? stTop.outline
    ? `clip-path: polygon(${stTop.outline})`
    : stTop.clip
      ? `clip-path: inset(${stTop.clip} round ${stTop.radius ?? 13}% / ${r4((stTop.radius ?? 13) * (ft.w / ft.h))}%)`
      : ''
  : stTop.corners ? `clip-path: ${stTop.corners}` : '';
const viewStyle = [
  `aspect-ratio: ${staged ? r4(boxAspect) : `${ft.w} / ${ft.h}`}`,
  stage ? `background: ${stage}` : '',
  devInStage ? '' : clipBaked,
].filter(Boolean).join('; ');

// ---- the bezel as the mat of a natural plate (its padding % is of the plate's own width = the device's) ----
const bz = BEZEL[resolvedFrame];
const matStyle = bz && !devInStage
  ? (() => {
      const p = bz.p / 100;
      const outerH = (1 - 2 * p) * (ft.h / ft.w) + 2 * p; // outer height in units of the outer width
      return `padding: ${bz.p}%; border-radius: ${bz.r}% / ${r4(bz.r / outerH)}%`;
    })()
  : undefined;

// ---- a device on a stage: the wrapper is the device's outer box, contained in the stage box with the layer's pad ----
// Bezels: outer aspect ao = 1 / ((1 − 2p)/a + 2p) for a ring of p × the device width; the ring is padding, whose % is
// of the VIEW's width (the containing block), so it is p × the device's width-share. Clips sit on the media's own box.
const devStyle = devInStage
  ? (() => {
      const a = ft.w / ft.h;
      const lp = top.pad ?? pad;
      if (bz) {
        const p = bz.p / 100;
        const ao = 1 / ((1 - 2 * p) / a + 2 * p);
        const rc = containRect(ao, boxAspect, lp);
        return `left: ${r4(rc.l)}%; top: ${r4(rc.t)}%; inline-size: ${r4(rc.w)}%; block-size: ${r4(rc.h)}%; padding: ${r4(bz.p * rc.w / 100)}%; border-radius: ${bz.r}% / ${r4(bz.r * ao)}%`;
      }
      const rc = containRect(a, boxAspect, lp);
      return [`left: ${r4(rc.l)}%; top: ${r4(rc.t)}%; inline-size: ${r4(rc.w)}%; block-size: ${r4(rc.h)}%`, clipBaked].filter(Boolean).join('; ');
    })()
  : undefined;

const rootStyle = [
  cap ? `max-inline-size: ${cap}px` : '',
  vt ? `view-transition-name: ${vt}` : '',
  secs ? `--_secs: ${secs}s` : '',
].filter(Boolean).join('; ');

// the Enlarge name is the figure number plus her caption when there is one — never the alt text, which the image
// itself carries (alt drafts run to several sentences; a button name repeating them would be read out twice) (WP7)
const enlargeLabel = fig
  ? fillTpl(m.enlargeLabel, { fig: fig.no }) + (fig.caption ? `: ${stripHtml(fig.caption)}` : '')
  : undefined;
// the drafting X: heavy media only. A bare staged plate (a cover) never gets one: its stage IS its loading state;
// transparent files never get one (it would show through them)
const showPh = !(staged && matFrame === 'bare') && layers.some((l) => wantsPlaceholder(l));
const coverIsDuplicate = canEnlarge && controls; // then the controls carry the visible, focusable Enlarge
// …except on the narrated video before its first play: its controls are hidden (only "Play · 0:48 · sound" shows), so
// the cover is its keyboard Enlarge until video.ts sees the first play and hands that role to the controls' Enlarge
const coverUntilPlayed = coverIsDuplicate && audio;
const coverHidden = coverIsDuplicate && !coverUntilPlayed;

/** per-layer geometry inside a staged box (a device-wrapped top layer fills its wrapper instead) */
const layerStyle = (layer: LayerMedia): string | undefined => {
  if (!staged || (devInStage && layer === top)) return undefined;
  const lp = layer.pad ?? pad;
  const lf = layer.fit ?? fit;
  return `inset: ${lp}%; inline-size: ${100 - 2 * lp}%; block-size: ${100 - 2 * lp}%; object-fit: ${lf === 'fill' ? 'fill' : 'contain'}`;
};
const topStyle = layerStyle(top);
// the dimension strings measure the TOP layer's rendered box, in % of the view
const dimRect = staged ? containRect(ft.aspect, viewAspect, top.pad ?? pad) : { l: 0, t: 0, w: 100, h: 100 };
const lcpGif = priority === 'high' && kindOf(top) === 'gif';

const Wrap = dims ? DimString : Fragment;
const wrapProps = dims ? { part: 'wrap' as const } : {};
const Win = matFrame === 'browser' ? FrameBrowser : Fragment;
const Dev = devInStage ? 'span' : Fragment;
const rootAttrs = {
  'data-plate': '',
  'data-file': fileOf(top),
  'data-kind': motionKind,
  'data-state': moving ? 'idle' : undefined,
  'data-managed': managed ? undefined : 'host',
  'data-fig-no': fig?.no,
  'data-cap-id': fig?.capId,
  'data-zoom': zoom ?? stTop.zoom,
  ...factAttrs(ft),
};
---
<Wrap {...wrapProps}>
  <div class:list={['plate', `plate--${matFrame}`, `plate--${motionKind}`, devInStage && `plate--dev-${device}`, { 'plate--staged': staged, 'plate--natural': !staged, 'plate--sound': audio }, cls]} style={rootStyle || undefined} {...rootAttrs}>
    <Win>
      {controls && ctlVariant === 'bar' && <MediaControls slot="tools" variant="bar" fig={fig?.no} enlarge={canEnlarge} audio={audio} />}
      {controls && ctlVariant === 'bar' && secs && <MediaControls slot="progress" part="progress" variant="bar" secs={secs} />}
      <div class="plate__mat" style={matStyle}>
        <div class="plate__view" style={viewStyle} data-ph-host={devInStage ? undefined : ''} data-state={moving && !devInStage ? 'idle' : undefined}>
          {showPh && <Placeholder media={top} />}
          {/* the LCP GIF (a cover on its own stage) has no drafting X — its stage stands in while it paints — except under
              Save-Data, where it waits for Play: then the X with the file's facts says what Play will load */}
          {!showPh && lcpGif && <Placeholder media={top} class="ph--save" />}
          {layers.map((layer, i) => {
            const f = facts(layer);
            const k = kinds[i];
            const isTop = i === layers.length - 1;
            // a device on a stage: this layer (and its poster canvas) sits inside the device's box
            const D = isTop && devInStage ? 'span' : Fragment;
            // the device's screen is the placeholder host: the drafting X shows ON the screen while it is idle/loading
            const dp = isTop && devInStage
              ? { class: `plate__dev plate__dev--${device}`, style: devStyle, 'data-ph-host': '', 'data-state': moving ? 'idle' : undefined }
              : {};
            const devCanvas = isTop && devInStage && k === 'gif';
            const devPh = isTop && devInStage && wantsPlaceholder(layer);
            const st = stagingOf(layer);
            const style = layerStyle(layer);
            const la = isTop ? alt : '';
            // an <img alt=""> is presentational: it may carry a description only once it has a name (alt.ts drafts, WP7)
            const desc = isTop && (la || k === 'video') ? describedBy : undefined;
            if (k === 'video') {
              const sound = !!st.video?.audio;
              return (
                <D {...dp}>
                  {devPh && <Placeholder media={layer} />}
                  <video class="plate__media" style={style} width={f.w} height={f.h} data-vid data-src={f.remote ? f.src : `${f.src}#t=0.001`} muted={!sound} playsinline preload="none" loop={loop && !sound} disablepictureinpicture aria-label={la || undefined} aria-describedby={desc}></video>
                  <noscript><video class="plate__media plate__media--ns" style={style} src={f.src} width={f.w} height={f.h} controls playsinline preload="metadata" muted={!sound}></video></noscript>
                </D>
              );
            }
            if (k === 'gif') {
              return (
                <D {...dp}>
                  {devPh && <Placeholder media={layer} />}
                  {lcpGif && isTop ? (
                    <Fragment>
                      <img class="plate__media" style={style} width={f.w} height={f.h} data-gif src={f.src} alt={la} decoding="async" fetchpriority="high" data-poster={st.gif?.poster} data-frames={st.gif?.frames} aria-describedby={desc} />
                      {/* motion off or Save-Data: hold the LCP GIF still before it can paint (the manager shows its poster, or under
                          Save-Data the drafting X; removing the src also lets the browser drop the download where nothing else holds it) */}
                      <script is:inline>(function(){var i=document.currentScript.previousElementSibling,d=document.documentElement;if(i&&(d.dataset.motion==='reduce'||d.hasAttribute('data-save'))){i.dataset.src=i.getAttribute('src');i.removeAttribute('src')}})()</script>
                    </Fragment>
                  ) : (
                    <img class="plate__media" style={style} width={f.w} height={f.h} data-gif data-src={f.src} alt={la} decoding="async" data-poster={st.gif?.poster} data-still-frame={st.gif?.still} data-frames={st.gif?.frames} aria-describedby={desc} />
                  )}
                  {/* the LCP GIF already has a real src: without JS it renders itself, so it has no twin */}
                  {!(lcpGif && isTop) && <noscript><img class="plate__media plate__media--ns" style={style} src={f.src} width={f.w} height={f.h} alt={la} loading="lazy" decoding="async" /></noscript>}
                  {devCanvas && <canvas class="plate__poster" hidden aria-hidden="true"></canvas>}
                </D>
              );
            }
            return <D {...dp}>{devPh && <Placeholder media={layer} />}<img class="plate__media" style={style} src={f.src} width={f.w} height={f.h} alt={la} loading={loading} decoding="async" fetchpriority={priority === 'high' && isTop ? 'high' : undefined} /></D>;
          })}
          {motionKind === 'gif' && !(devInStage && kindOf(top) === 'gif') && <canvas class="plate__poster" style={topStyle} hidden aria-hidden="true"></canvas>}
          {audio && (
            <button type="button" class="plate__sound" data-mc-sound data-js-only>
              <span class="plate__sound-disc" aria-hidden="true"><Icon name="play" class="plate__sound-i" /></span>
              <span class="sr-only">{soundLabel}</span>
              <span class="plate__sound-l" aria-hidden="true">
                {soundUnits.slice(1).map((u, i) => (<Fragment>{i > 0 && <span class="plate__sound-dot">·</span>}<span>{u}</span></Fragment>))}
              </span>
            </button>
          )}
          {dims && <DimString part="lines" rect={dimRect} w={ft.w} h={ft.h} />}
        </div>
        {controls && ctlVariant === 'overlay' && <MediaControls variant="overlay" fig={fig?.no} enlarge={canEnlarge} audio={audio} />}
        {canEnlarge && (
          <button type="button" class="plate__open" data-fig data-js-only aria-label={enlargeLabel} tabindex={coverHidden ? '-1' : undefined} aria-hidden={coverHidden ? 'true' : undefined} data-cover-until-played={coverUntilPlayed ? '' : undefined}></button>
        )}
      </div>
    </Win>
    {controls && ctlVariant !== 'bar' && secs && <MediaControls part="progress" variant={ctlVariant} secs={secs} />}
    {controls && ctlVariant === 'below' && <MediaControls variant="below" fig={fig?.no} enlarge={canEnlarge} audio={audio} />}
    {fig?.caption && !fig.capId && <template data-cap set:html={rich(fig.caption)} />}
    {/* the module script renders where it is written (once per page): inside the root, so it never becomes a sibling
       that breaks the `+` spacing rules between blocks */}
    <script>
      import '../../scripts/media/plates';
    </script>
  </div>
</Wrap>
<style>
  .plate { position: relative; min-inline-size: 0; }
  .plate__view > :global(.ph.ph--save) { display: none; }
  :global(html[data-save]) .plate__view > :global(.ph.ph--save) { display: grid; }
  .plate--staged { inline-size: 100%; }
  .plate__mat { position: relative; }
  .plate__view { position: relative; inline-size: 100%; }
  .plate__media, .plate__poster {
    position: absolute; inset: 0;
    display: block; inline-size: 100%; block-size: 100%;
    max-inline-size: none;
  }
  /* media without pixels yet (a managed GIF/video before it mounts, or parked): its alt stays in the a11y tree,
     the drafting X shows through */
  .plate__media:is(img, video):not([src]) { opacity: 0; }
  :global(html:not(.js)) .plate__media[data-src] { display: none; }
  .plate__poster { z-index: var(--z-raised); }

  /* ---------- frames (§6.3) ---------- */
  /* plate: her white artefact on a --plate mat; the hairline sits OUTSIDE the file (never over her edge pixels) */
  .plate--plate .plate__mat { background: var(--plate); box-shadow: 0 0 0 var(--lw-object) var(--line-2); }
  /* print: photographs as prints — an 8px --plate border and a soft shadow; the aspect never changes */
  .plate--print .plate__mat { background: var(--plate); padding: var(--s-2); box-shadow: var(--shadow-plate); }
  /* before: her intentionally dated material on a --before surround. --before alone is the paper's own value (it read
     as nothing, and her screenshot as 16px mis-indented), so the surround is drawn as material: the 45° hatch of
     existing work over --before, with an object-line edge */
  .plate--before .plate__mat {
    background: var(--hatch-45), var(--before); padding: var(--s-4);
    box-shadow: 0 0 0 var(--lw-object) var(--line-2);
  }
  /* phone / bezel-dark: a device ring around her flat screen (geometry inline: her square corners are never hidden) */
  .plate--phone .plate__mat { background: var(--bezel); }
  .plate--bezel-dark .plate__mat { background: var(--bezel-dark); }
  /* the device's metal band: a hairline rim outside the ring, so a dark device still reads on Dusk's dark paper */
  :is(.plate--phone, .plate--bezel-dark) .plate__mat { box-shadow: 0 0 0 var(--lw-object) var(--line-2); }
  /* phone-video: the baked device's white canvas corners are clipped (≈ 10 px, §6.4) */
  .plate--phone-video .plate__view { clip-path: inset(0 round 5% / 2.3%); }
  /* phone-baked: clipped to the device silhouette (inline polygon), sized BY HEIGHT so the phones read as one size */
  .plate--phone-baked { inline-size: fit-content; max-inline-size: 100%; margin-inline: auto; }
  .plate--phone-baked { --_ph: min(480px, 72svh); } /* component geometry: a baked phone's height outside a walkthrough */
  .plate--phone-baked .plate__view { block-size: var(--ph, var(--_ph)); inline-size: auto; }
  /* a device on a stage (Play's pinned plates, a card): the device box sits in the stage like the layer would; its
     media fills the content box (the ring is padding), and a GIF's poster canvas overlaps it (one grid cell) */
  .plate__dev { position: absolute; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); overflow: hidden; }
  .plate__dev > :global(:is(.plate__media, .plate__poster, .ph)) { position: relative; inset: auto; grid-area: 1 / 1; }
  .plate__dev > :global(.ph) { block-size: auto; z-index: var(--z-raised); }
  .plate__dev--phone { background: var(--bezel); box-shadow: 0 0 0 var(--lw-object) var(--line-2); }
  .plate__dev--bezel-dark { background: var(--bezel-dark); box-shadow: 0 0 0 var(--lw-object) var(--line-2); }
  .plate__dev--phone-video { clip-path: inset(0 round 5% / 2.3%); }
  /* browser: the mat is the window's glass */
  .plate--browser .plate__mat { background: var(--plate); }
  /* soft: logo material composed on white — a pure-white sheet (its white canvas vanishes, as on her white site), a
     hairline, and the breathing room a logo sheet gives its marks */
  .plate--soft .plate__mat { background: var(--white); box-shadow: 0 0 0 var(--lw-object) var(--line-2); padding: var(--s-5); }

  /* ---------- the Enlarged-detail trigger covers the media (never the controls) ---------- */
  .plate__open {
    position: absolute; inset: 0; z-index: var(--z-raised);
    inline-size: 100%; block-size: 100%;
    cursor: zoom-in;
    background: transparent;
  }

  /* The narrated video before its first play (Teachable, SPEC §5.4: "the bezel plus a centred button"): a phone that
     is off. Its screen is dark glass a shade lifted from the bezel (a host may tint it, --plate-screen-off: Play tints
     it with her stage colour), with no drafting X and no file facts — on a device's screen they read as a failed
     asset. On it, centred, a play control (polish r1): a 56px disc (--plate: a device's control never inverts) with ▶, and
     "0:48 · sound" as one mono line under it — the size of a real player's control at every screen width, where the
     stamped box of stacked units read as a form label. Its name is the full string "Play · 0:48 · sound" (visually
     hidden text; the drawn units are aria-hidden). */
  .plate--sound .plate__view { container: plate-screen / inline-size; }
  .plate--sound:not([data-played]) .plate__view {
    background: var(--plate-screen-off, color-mix(in oklab, var(--bezel-dark) 86%, var(--ink-3)));
  }
  .plate--sound:not([data-played]) .plate__view > :global(.ph) { display: none; }
  .plate__sound {
    position: absolute; inset: 50% auto auto 50%; translate: -50% -50%; z-index: calc(var(--z-raised) + 1);
    display: inline-flex; flex-direction: column; align-items: center; gap: var(--s-3);
    inline-size: max-content; max-inline-size: calc(100% - 2 * var(--s-3));
    padding: var(--s-2); background: none; border: 0;
    font-family: var(--font-mono); font-size: var(--fs-code); font-weight: var(--wt-code); letter-spacing: var(--tr-code);
    text-transform: uppercase; color: var(--plate);
  }
  .plate__sound-disc {
    display: grid; place-items: center; inline-size: calc(var(--s-8) - var(--s-2)); block-size: calc(var(--s-8) - var(--s-2));
    border-radius: var(--r-dot); background: var(--plate); color: var(--bezel);
    box-shadow: 0 0 0 var(--lw-object) var(--bezel), var(--shadow-lift);
    transition: background-color var(--dur-1) var(--ease-ui), color var(--dur-1) var(--ease-ui), scale var(--dur-2) var(--ease-ui);
  }
  .plate__sound-l { display: inline-flex; align-items: baseline; gap: var(--s-1); white-space: nowrap; }
  .plate__sound-dot { opacity: .7; }
