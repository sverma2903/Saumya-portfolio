---
/**
 * Crossword · WP6 (SPEC §5.4). LEGEND · DATA / DESIGN / NERDS — her tile grid from her original home page, moved here
 * as the sheet's legend: her letters on outline / solid tiles, every other tile a drafting material in her colours,
 * and beside it the two keys the grid reads by (tiles.ts): WORDS (what her letters spell, → across / ↓ down, as a
 * crossword's) and MATERIALS (what the other tiles are drawn in).
 *   ≥ 1280px   grid │ words │ materials on the board's 12 columns
 *   768–1279   the panel still runs the sheet's width: grid │ words │ materials when they fit (panel ≥ 760px),
 *              else grid │ words over materials
 *   < 768px    stacked; the tiles take the panel's width (5 tiles + 4 gaps = the measure), between 44 and 64px
 *
 * Interaction (scripts/play/crossword.ts):
 *   · Re-lay tiles   shuffles the materials of the non-letter tiles — "re-laying the roof" of her kavelu tiles:
 *                    FLIP, 240ms with an 18ms stagger (from the duration tokens); instant under reduced motion and
 *                    when pressed from the keyboard (motion law 1)
 *   · each tile is a grid cell with a roving tabindex: arrows, Home/End (row), Ctrl+Home/End (grid)
 *   · Enter / Space / click on a material tile cycles its material (the tiles are <button>s); letter tiles are
 *     focusable cells named by their words ("D — letter tile, DESIGN and DATA") and do nothing when pressed
 *   · the T turns to ⊥ on hover / focus (a detail from her original)
 *   · the keys and the grid point at each other: hovering / focusing a tile lights its key rows (its words, or its
 *     material), and hovering a key row lights its tiles
 *   · no drag; tiles are 64px (52px on phones): ≥ 48 / 44px targets
 * Without JS the grid is one labelled image (role=img, with no keyboard hint: there is nothing to operate) and the
 * Re-lay button is hidden (data-js-only). crossword.ts adds aria-describedby="legend-hint" when it makes it a grid.
 */
import { chrome, fill } from '../../data/chrome';
import Icon from '../symbols/Icon.astro';
import { GRID, HER, MATERIALS, materialById, wordsAt, wordsOf } from './tiles';
const p = chrome.wp6.play;
const matName = (id: keyof typeof p.materials) => p.materials[id];
const cells = GRID.map((row, r) =>
  row.map((t, c) => {
    if (t.kind === 'letter') {
      const words = wordsAt(r, c).join(p.wordJoin);
      return { ...t, label: fill(p.tileLetter, { l: t.l, words }) };
    }
    const m = materialById(t.mat);
    return { ...t, m, label: fill(p.tileMaterial, { material: matName(t.mat) }) };
  }),
);
const mats = MATERIALS.map((m) => ({ ...m, name: matName(m.id) }));
const words = wordsOf().map((w) => ({ ...w, at: w.cells.map(([r, c]) => `${r}.${c}`).join(' ') }));
---
<section class="legend shell" aria-labelledby="legend-h" data-xw-root data-l-mat={p.tileMaterial} data-l-relaid={p.relaid}>
  <div class="legend__panel">
    <div class="legend__head">
      <h2 id="legend-h" class="legend__h t-label-lg">{p.legend}</h2>
      <button type="button" class="btn legend__relay" data-xw-relay data-js-only>
        <svg class="legend__relay-i" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 9.5h13l-4-4M20.5 14.5h-13l4 4" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="square" vector-effect="non-scaling-stroke" /></svg>
        <span>{p.relay}</span>
      </button>
    </div>
    <div class="legend__body">
      <div class="xw" role="img" aria-label={p.gridLabel} data-xw style={`--_ink: ${HER.rust}; --_solid: ${HER.oxblood}`}>
        {cells.map((row, r) => (
          <div class="xw__row" data-xw-row>
            {row.map((t, c) =>
              t.kind === 'letter' ? (
                <span class:list={['xw__cell', 'xw__cell--letter', `xw__cell--${t.look}`, { 'xw__cell--t': t.l === 'T' }]} data-xw-cell data-at={`${r}.${c}`} data-label={t.label}>
                  <span class="xw__g" style={t.weight ? `--_w: ${t.weight}` : undefined} data-v>{t.l}</span>
                </span>
              ) : (
                <span class="xw__cell xw__cell--mat" data-xw-cell data-mat={t.mat} data-label={t.label}>
                  <span class="xw__m" data-mat={t.mat} data-p={t.m.p} style={`--_c: ${t.m.c}`}></span>
                </span>
              ),
            )}
          </div>
        ))}
      </div>
      <div class="legend__keys">
        <div class="legend__key">
          <p class="legend__kh t-label">{p.wordsTitle}</p>
          <ul class="legend__list" role="list">
            {words.map((w) => (
              <li class="legend__row" data-key-word={w.at}>
                <span class="legend__sw legend__dir" aria-hidden="true"><Icon name={w.dir === 'across' ? 'arrow-right' : 'arrow-down'} size={14} /></span>
                <span class="legend__word">{w.w}</span>
                <span class="legend__how">{p[w.dir]}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="legend__key">
          <p class="legend__kh t-label">{p.materialsTitle}</p>
          <ul class="legend__list" role="list">
            {mats.map((m) => (
              <li class="legend__row" data-key-mat={m.id}>
                <span class="legend__sw" aria-hidden="true"><span class="xw__m" data-mat={m.id} data-p={m.p} style={`--_c: ${m.c}`}></span></span>
                <span class="legend__name" data-name>{m.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
  <p id="legend-hint" class="sr-only" hidden>{p.gridHint}</p>
  <p class="sr-only" role="status" data-xw-status></p>
</section>
<script>
  import '../../scripts/play/crossword';
</script>
<style>
  .legend {
    --_t: var(--s-8);             /* a tile: 64px (52px on phones) — a ≥ 44px target */
    --_gap: calc(var(--s-1) * 1.5);
    padding-block: var(--s-6) var(--s-10);
  }
  /* the legend is a panel on the sheet, as a drawing's legend is: an ink frame, a label strip, the grid and its key */
  /* it runs the sheet's width at every size, so its right edge shares the pin board's column line; it is the container
     the tiles (phones) and the keys' layout (768–1279) are sized from */
  .legend__panel {
    container: legend / inline-size;
    border: var(--lw-border) solid var(--ink);
    background: var(--sheet);
  }
  .legend__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-7);
    padding: var(--s-3) var(--s-5);
    border-block-end: var(--lw-object) solid var(--line-2);
  }
  .legend__h { color: var(--ink-2); }
  .legend__relay { transition: color var(--dur-1) var(--ease-ui); }
  .legend__relay-i { flex: none; }
  .legend__body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--s-6) var(--s-8);
    padding: var(--s-6) var(--s-5) var(--s-6);
  }
  /* the two keys: side by side (≥ 1280, and on phones when they fit), one over the other beside the grid between */
  .legend__keys { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--s-6) var(--s-7); }

  /* ---------- the grid ---------- */
  .xw { display: grid; gap: var(--_gap); inline-size: max-content; }
  .xw__row { display: grid; grid-template-columns: repeat(5, var(--_t)); gap: var(--_gap); }
  .xw__cell {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: var(--_t);
    block-size: var(--_t);
    border-radius: var(--r-1);
    font-family: var(--font-serif);
    font-size: calc(var(--_t) * 0.46);
    line-height: 1;
  }
  /* letter tiles: raised pieces in her colours (a --lw-cut frame and a plate's shadow), the same in Vellum and Dusk
     (like plates). Materials are the other register: swatches inset in their beds, never framed like a letter. */
  .xw__cell--outline { color: var(--_ink); background: var(--plate); box-shadow: inset 0 0 0 var(--lw-cut) currentColor, var(--shadow-plate); }
  .xw__cell--solid { color: var(--plate); background: var(--_solid); box-shadow: inset 0 0 0 var(--lw-cut) color-mix(in oklab, var(--_solid) 70%, var(--ink)), var(--shadow-plate); }
  /* a material tile's bed: a faint sunk outline around its swatch (the whole bed shows while the swatch is away) */
  .xw__cell--mat { box-shadow: inset 0 0 0 var(--lw-object) var(--line-1); }
  /* optically centred: in a line-height-1 box Newsreader's capitals sit .13em above the middle (measured), so each
     letter comes down by that much */
  .xw__g { font-weight: var(--_w, 500); translate: 0 0.13em; }
  /* the T turns over into ⊥ (a detail from her original) */
  .xw__cell--t { perspective: calc(var(--_t) * 3); }
  /* turn about the middle of the capital: .37em from the top of its box (the .5em middle less those .13em) */
  .xw__cell--t .xw__g { display: inline-block; transform-origin: 50% 0.37em; transition: rotate var(--dur-3) var(--ease-pen); }
  .xw__cell--t:is(:hover, :focus-visible) .xw__g { rotate: x 180deg; }
  /* while the keyboard walks the grid nothing animates (motion law 1) */
  .xw:focus-within .xw__g { transition-duration: 0s; }

  /* material tiles: a --plate sample with the material drawn in her colour */
  .xw__m {
    /* --_c is her colour (inline, and set again when a tile is re-laid); --_cl is the ink the material is drawn in and
       --_bed the ground it is drawn on (both themed below) */
    --_cl: var(--_c);
    --_bed: var(--plate);
    position: absolute;
    inset: 0;
    border-radius: var(--r-1);
    background-color: var(--_bed);
    box-shadow: inset 0 0 0 var(--lw-object) color-mix(in srgb, var(--_cl) 70%, transparent);
  }
  /* in the grid a swatch sits one --s-1 inside its bed */
  .xw .xw__m { inset: var(--s-1); border-radius: 0; }
  .xw__m[data-p='solid'] { background-color: var(--_cl); box-shadow: none; }
  /* poché is grained, not flat: a fine 45° hatch of its own colour let down toward the plate */
  .xw__m[data-p='poche'] {
    background-color: var(--_c);
    background-image: repeating-linear-gradient(45deg, color-mix(in oklab, var(--_c) 72%, var(--plate)) 0 var(--lw-object), transparent var(--lw-object) var(--s-1));
    box-shadow: none;
  }
  .xw__m[data-p='hatch'] { background-image: repeating-linear-gradient(-45deg, var(--_cl) 0 var(--lw-border), transparent var(--lw-border) calc(var(--s-1) * 1.5)); }
  .xw__m[data-p='hatch2'] { background-image: repeating-linear-gradient(45deg, var(--_cl) 0 var(--lw-border), transparent var(--lw-border) calc(var(--s-1) * 1.5)); }
  .xw__m[data-p='cross'] {
    background-image:
      repeating-linear-gradient(-45deg, var(--_cl) 0 var(--lw-object), transparent var(--lw-object) var(--s-2)),
      repeating-linear-gradient(45deg, var(--_cl) 0 var(--lw-object), transparent var(--lw-object) var(--s-2));
  }
  .xw__m[data-p='rows'] { background-image: repeating-linear-gradient(180deg, var(--_cl) 0 var(--lw-object), transparent var(--lw-object) calc(var(--s-1) * 1.5)); }
  .xw__m[data-p='dots'] {
    background-image: radial-gradient(circle, var(--_cl) 0 var(--lw-border), transparent calc(var(--lw-border) * 1.4));
    background-size: calc(var(--s-1) * 1.5) calc(var(--s-1) * 1.5);
  }
  /* the void is an absence: a dashed hidden line on the sheet, not the letters' rust outline and not a lit plate */
  .xw__m[data-p='void'] { background: none; box-shadow: none; border: var(--lw-object) dashed var(--line-2); }

  /* with JS, material tiles are buttons; while re-laid, each swatch flies from its old cell to its new one */
  .xw :global(.xw__btn) { position: absolute; inset: 0; border-radius: var(--r-1); cursor: pointer; }
  .xw :global(.xw__btn:hover) > .xw__m { outline: var(--lw-object) solid var(--line-3); outline-offset: calc(var(--s-1) / 2); }
  .xw .xw__m:global(.is-flying) { z-index: var(--z-raised); box-shadow: var(--shadow-lift); }
  .xw__cell.is-lit > .xw__m, .xw :global(.xw__btn.is-lit) > .xw__m { outline: var(--lw-cut) solid var(--rust); outline-offset: calc(var(--s-1) / 2); }

  /* the letter tiles a word key row points at */
  .xw__cell--letter.is-lit { outline: var(--lw-cut) solid var(--rust); outline-offset: calc(var(--s-1) / 2); }
  /* while a key row points at the grid, the tiles it names stay and every other tile steps back (lit by subtraction) */
  .xw__cell { transition: opacity var(--dur-1) var(--ease-ui); }
  .xw[data-pointing] .xw__cell:not(.is-lit) { opacity: 0.35; }

  /* ---------- the keys ---------- */
  .legend__key { min-inline-size: var(--s-11); }
  /* both keys read on one pitch: half a tile row (35px; 28px on phones), so their lines share baselines with each other
     and fall on the grid's rows. The key header takes the first half-row: its cap line is level with the grid's top. */
  .legend__keys { --_pitch: calc((var(--_t) + var(--_gap)) / 2); }
  .legend__kh {
    display: flex;
    align-items: flex-start;
    block-size: var(--_pitch);
    line-height: 1;
    color: var(--ink-2);
    border-block-end: var(--lw-object) solid var(--line-2);
  }
  .legend__list { list-style: none; padding: 0; display: grid; }
  .legend__row {
    --_band: var(--paper-2);        /* a lit row: a band of the sheet's well colour behind it */
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-block-size: var(--_pitch);
    padding-block: 0;
    padding-inline: var(--s-1);
    margin-inline: calc(-1 * var(--s-1));
    font-family: var(--font-sans);
    font-size: var(--fs-ui);
    font-variation-settings: var(--wdth-ui);
    color: var(--ink-2);
    transition: color var(--dur-1) var(--ease-ui), background-color var(--dur-1) var(--ease-ui);
  }
  .legend__sw { position: relative; flex: none; inline-size: var(--s-5); block-size: var(--s-5); }
  /* a word's swatch: a small blank tile carrying its direction */
  .legend__dir {
    display: grid;
    place-items: center;
    border-radius: var(--r-1);
    box-shadow: inset 0 0 0 var(--lw-object) var(--line-2);
    color: var(--rust);
  }
  .legend__word { font-family: var(--font-serif); font-size: var(--fs-body-sm); font-weight: 500; letter-spacing: var(--tr-code); color: var(--ink); translate: 0 0.13em; }
  .legend__how {
    margin-inline-start: auto;
    padding-inline-start: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-code-sm);
    letter-spacing: var(--tr-code-sm);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .legend__row.is-lit { color: var(--ink); background: var(--_band); }
  .legend__row.is-lit :is(.legend__name, .legend__word) { text-decoration: underline; text-decoration-color: var(--rust); text-underline-offset: var(--s-1); text-decoration-thickness: var(--lw-border); }
  /* with JS a key row points at its tiles on hover, so it answers the pointer too */
  @media (hover: hover) {
    :global(html.js) .legend__row:hover { color: var(--ink); background: var(--_band); }
    :global(html.js) .legend__row:hover :is(.legend__name, .legend__word) { text-decoration: underline; text-decoration-color: var(--rust); text-underline-offset: var(--s-1); text-decoration-thickness: var(--lw-border); }
  }

  @media (min-width: 768px) and (max-width: 1279.98px) {
    /* the grid, then the keys in the rest of the panel: one over the other while the panel is narrow ... */
    .legend__body { display: grid; grid-template-columns: max-content minmax(0, 1fr); column-gap: var(--s-5); }
    .legend__keys { flex-direction: column; flex-wrap: nowrap; align-items: stretch; }
    .legend__key { min-inline-size: 0; }
    /* ... side by side as soon as they fit, so the WORDS column fills the space under the grid's first rows */
    @container legend (min-width: 760px) {
      .legend__body { grid-template-columns: max-content minmax(max-content, 1fr) minmax(max-content, 1fr); }
      .legend__keys { grid-column: 2 / -1; display: grid; grid-template-columns: subgrid; column-gap: var(--s-5); }
    }
  }
  @media (min-width: 1280px) {
    /* the whole sheet width, on the pin board's twelve columns: the grid in 1–4, WORDS in 5–8, MATERIALS in 9–12
       (the panel's padding is taken out of the first and last columns, so the inner column lines are the board's) */
    .legend__body {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--g);
      padding-inline: var(--s-5);
    }
    .xw { grid-column: 1 / span 4; }
    .legend__keys { grid-column: 5 / -1; display: grid; grid-template-columns: subgrid; }
    .legend__key { min-inline-size: 0; }
    .legend__key:first-child { grid-column: 1 / span 4; }
    .legend__key:last-child { grid-column: 5 / -1; }
  }

  @media (max-width: 767.98px) {
    /* the tiles take the panel's measure: 5 tiles and 4 gaps fill it (61px at 390), never under a 44px target (47px at
       320) nor over the desktop 64px */
    .legend {
      --_gap: var(--s-1);
      --_t: clamp(calc(var(--s-6) + var(--s-3)), (100cqi - 2 * var(--s-4) - 4 * var(--_gap)) / 5, var(--s-8));
      padding-block: var(--s-5) var(--s-9);
    }
    .legend__head { padding-inline: var(--s-4); }
    .legend__body { padding: var(--s-5) var(--s-4); }
    .legend__keys { column-gap: var(--s-5); }
    .legend__key { min-inline-size: 0; flex: 1 1 auto; }
  }
  /* Dusk: the materials are drawn on the panel's own dark ground in a lifted ink (a cream bed under every hatch made
     the grid a glaring checkerboard); poché keeps its oxblood with a lifted edge so it still reads; blush is a wash.
     Only the outline letter tiles stay plates (lit prints, as everywhere on the dark wall). */
  :global(html[data-theme='dusk']) .xw__m { --_bed: var(--sheet); --_cl: color-mix(in oklab, var(--_c) 70%, var(--plate)); }
  :global(html[data-theme='dusk']) .xw__m[data-p='solid'] {
    background-color: color-mix(in oklab, var(--_c) 22%, var(--sheet));
    box-shadow: inset 0 0 0 var(--lw-object) color-mix(in oklab, var(--_c) 60%, var(--sheet));
  }
  :global(html[data-theme='dusk']) .xw__m[data-p='poche'] { box-shadow: inset 0 0 0 var(--lw-object) color-mix(in oklab, var(--_c) 55%, var(--plate)); }
  :global(html[data-theme='dusk']) .legend__row { --_band: color-mix(in oklab, var(--ink) 8%, var(--sheet)); }
  @media (forced-colors: active) {
    .xw__cell, .xw__m { forced-color-adjust: none; }
    .xw__cell { outline: 1px solid CanvasText; }
    .legend__dir { outline: 1px solid CanvasText; outline-offset: -1px; }
  }
</style>
