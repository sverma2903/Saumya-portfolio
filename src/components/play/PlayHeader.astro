---
/**
 * PlayHeader · WP6 (SPEC §5.4). The head of sheet C-100:
 *   C-100 ─── PLAY   (chrome: sheet number in Plex Mono rust, a rule, the label — as the cover sheet's eyebrow)
 *   her headline (h1, --fs-title; her <em>side quests</em> stays italic) + the ✦ Ornament (it is in her original h1)
 *   her sub-line (--fs-body-md, ink-2, at the reading measure)
 */
import { play } from '../../content/site';
import { chrome } from '../../data/chrome';
import Ornament from '../symbols/Ornament.astro';
const p = chrome.wp6.play;
---
<header class="play-head shell">
  <p class="play-head__eyebrow t-label-lg"><span class="play-head__sheet t-code">{p.sheet}</span><span class="play-head__rule" aria-hidden="true"></span><span>{p.title}</span></p>
  <h1 class="play-head__h" id="play-h" data-v><Fragment set:html={play.headline} /> <Ornament /></h1>
  <p class="play-head__sub" data-v set:html={play.sub} />
</header>
<style>
  .play-head { padding-block: var(--s-8) var(--s-8); }
  .play-head__eyebrow { display: flex; align-items: center; gap: var(--s-3); margin-block-end: var(--s-5); color: var(--ink-2); }
  .play-head__sheet { color: var(--rust); }
  .play-head__rule { inline-size: var(--s-7); border-block-start: var(--lw-object) solid var(--line-3); }
  .play-head__h {
    font-family: var(--font-serif);
    font-size: var(--fs-title);
    font-weight: var(--wt-title);
    line-height: var(--lh-title);
    letter-spacing: var(--tr-title);
    max-inline-size: 18em;
    text-wrap: balance;
  }
  .play-head__sub {
    margin-block-start: var(--s-6);
    max-inline-size: var(--measure);
    font-size: var(--fs-body-md);
    line-height: var(--lh-body-md);
    color: var(--ink-2);
  }
  @media (max-width: 1023.98px) {
    .play-head { padding-block: var(--s-6) var(--s-8); }
    .play-head__sub { margin-block-start: var(--s-5); }
  }
</style>
