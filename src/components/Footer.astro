---
import { links, home } from '../content/site';
const { heading = home.connect } = Astro.props;
---
<footer class="footer" data-nav="dark" data-field-host>
  <div class="gl-fallback"></div>
  <canvas class="gl" data-field data-shade="0.4" data-seed="7.3" aria-hidden="true"></canvas>
  <div class="wrap footer-inner">
    <p class="mono" style="color: color-mix(in srgb, var(--cream) 60%, transparent)" data-reveal>( Say hello )</p>
    <h2 class="footer-cta" data-split>{heading}</h2>
    <div class="footer-actions" data-reveal>
      <a class="btn light" href={links.email} data-magnetic>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        saumyaverma29@gmail.com
      </a>
      <a class="btn light" href={links.linkedin} target="_blank" rel="noopener" data-magnetic>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.83v1.54h.05c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.67 4.8 6.13V21h-4v-5.02c0-1.2-.02-2.74-1.67-2.74-1.67 0-1.93 1.3-1.93 2.65V21h-4V9.75Z"/></svg>
        LinkedIn <span class="arrow">↗</span>
      </a>
      <a class="btn light" href={links.resume} target="_blank" rel="noopener" data-magnetic>Resume <span class="arrow">↗</span></a>
    </div>
    <div class="footer-base">
      <span>{home.copyright}</span>
      <nav aria-label="Footer">
        <a href="/#work">Work</a>
        <a href="/about">About</a>
        <a href="/fun">Play</a>
      </nav>
    </div>
  </div>
</footer>
