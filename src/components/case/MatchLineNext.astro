---
/**
 * MatchLineNext · WP5. The end of a sheet (SPEC §5.2.4): the match line that carries you to the next one.
 *
 *   NEXT PROJECT ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ ━━ ━ A-102
 *   ┌──────────────────────────────┐
 *   │ next cover plate 16:10       │   Auditable Approvals for Emergency Spending          ← her index title
 *   │ view-transition: plate-pff   │   Rebuilt a legacy budget platform into a system…      ← her index line
 *   └──────────────────────────────┘   [ Read case study → ]   ↑ All work
 * (polish r1: plain words lead — "Next project", "Read case study", "All work" — and the sheet number is the tag.)
 *
 * Next = the following case in site.ts `cases`, cycling (sheets.ts nextCase). The link is her next title, stretched over
 * the whole card (one tab stop, a concise name, the card as the target; the drawn "Open sheet" button is its label for
 * sight). The plate carries view-transition-name plate-<next> so it morphs into the next sheet's cover (SM3).
 */
import type { Sheet } from '../../data/sheets';
import { plateLayers } from '../../data/sheets';
import { chrome, fill } from '../../data/chrome';
import MatchLine from '../symbols/MatchLine.astro';
import Icon from '../symbols/Icon.astro';
import Plate from '../media/Plate.astro';
import { keepCompounds } from '../../lib/typeset';
interface Props { next: Sheet }
const { next } = Astro.props;
const l = chrome.wp5.levels;
const no = String(next.no);
---
<section class="matchline shell" aria-label={l.matchLine} data-matchline>
  <p class="matchline__rule t-label" aria-hidden="true">
    <span class="matchline__rk">{l.matchLine}</span>
    <MatchLine class="matchline__cut" />
    <span class="matchline__rk matchline__see t-code">{fill(l.seeSheet, { no })}</span>
  </p>
  <div class="matchline__card" data-matchline-card>
    {next.plate && (
      <span class="matchline__plate">
        <Plate layers={plateLayers(next.plate)} stage={next.plate.stage} aspect={next.plate.aspect} vt={`plate-${next.slug}`} alt="" frame="bare" class="matchline__cover" />
      </span>
    )}
    <span class="matchline__text">
      <a class="matchline__title" href={next.href} data-v set:html={keepCompounds(next.title.text)} />
      {next.line && <span class="matchline__line" data-v>{next.line.text}</span>}
      <span class="matchline__foot">
        <span class="btn matchline__btn" aria-hidden="true">{fill(l.open, { no })}<Icon name="arrow-right" /></span>
        <a class="matchline__up t-label" href="/#index"><span class="matchline__uparrow" aria-hidden="true">↑</span> {l.toIndex}</a>
      </span>
    </span>
  </div>
</section>

<style>
  /* presentation-only typesetting of her words (lib/typeset.ts keepCompounds; textContent unchanged): a hyphenated
     compound never breaks at its hyphen */
  .matchline__title :global(.nobr) { white-space: nowrap; }
  .matchline { padding-block: var(--space-chapter) 0; display: grid; gap: var(--s-6); }
  /* the foot: the drawn way in, and the way back to all work beside it (polish r1: the sheet no longer ends on an
     orphan link under the card). "All work" is its own link, raised over the card's stretched link. */
  .matchline__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); margin-block-start: var(--s-3); }
  .matchline__foot .matchline__up { position: relative; z-index: calc(var(--z-raised) + 1); }
  .matchline__rule { display: flex; align-items: center; gap: var(--s-4); margin: 0; color: var(--ink-2); }
  .matchline__rk { flex: none; }
  .matchline__see { color: var(--rust); }
  .matchline__rule :global(.matchline__cut) { color: var(--ink); }

  .matchline__card {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-5);
    color: var(--ink);
  }
  .matchline__plate { display: block; min-inline-size: 0; }
  .matchline__plate :global(.matchline__cover) { box-shadow: var(--shadow-plate); outline: var(--lw-object) solid var(--line-1); transition: box-shadow var(--dur-3) var(--ease-pen); }
  @media (hover: hover) {
    .matchline__card:hover .matchline__plate :global(.matchline__cover) { box-shadow: var(--shadow-lift); }
  }
  .matchline__text { display: grid; gap: var(--s-3); justify-items: start; align-content: center; }
  .matchline__title {
    font-family: var(--font-serif); font-size: var(--fs-lede-lg); font-weight: var(--wt-lede-lg);
    line-height: var(--lh-lede-lg); letter-spacing: var(--tr-lede-lg); text-wrap: balance;
    color: var(--ink); text-decoration: none;
    transition: color var(--dur-1) var(--ease-ui);
  }
  /* the stretched link: the whole card is the target */
  .matchline__title::after { content: ''; position: absolute; inset: 0; z-index: var(--z-raised); }
  .matchline__title:focus-visible { outline: none; }
  .matchline__card:has(.matchline__title:focus-visible) { outline: 2px solid var(--focus); outline-offset: var(--s-3); }
  .matchline__line { font-family: var(--font-serif); font-style: italic; font-size: var(--fs-body-md); line-height: var(--lh-body-md); color: var(--ink-2); max-inline-size: 34em; text-wrap: pretty; }
  .matchline__btn { background-image: var(--hatch-blush); background-repeat: no-repeat; background-size: 0% 100%; transition: background-size var(--dur-3) var(--ease-pen), color var(--dur-1) var(--ease-ui); }
  .matchline__btn :global(.icon) { transition: transform var(--dur-2) var(--ease-ui); }
  @media (hover: hover) {
    .matchline__card:hover .matchline__title { color: var(--rust-deep); }
    .matchline__card:hover .matchline__btn { background-size: 100% 100%; color: var(--rust-deep); }
    .matchline__card:hover .matchline__btn :global(.icon) { transform: translateX(3px); }
  }

  .matchline__up { justify-self: start; display: inline-flex; align-items: center; gap: var(--s-2); min-block-size: var(--hit); color: var(--ink-2); text-decoration: none; }
  .matchline__uparrow { font-family: var(--font-sans); }
  @media (hover: hover) {
    .matchline__up:hover { color: var(--rust-deep); }
  }

  @media (min-width: 768px) {
    .matchline__card { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: var(--s-6); align-items: center; }
  }
  @media (min-width: 1024px) {
    .matchline__card { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: calc(var(--g) * 2); }
  }
  @media print { .matchline { display: none; } }
</style>
