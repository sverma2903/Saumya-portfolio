---
/**
 * CaseHeader · WP5. The 6-second layer of a sheet (SPEC §5.2.1).
 *
 *   ← A-000 DRAWING INDEX
 *   PERSONAL PROJECT                         ┌──────────────────────────────┐
 *   Cloudflare R2 Object                     │ cover plate 16:10 on its stage│  view-transition-name: plate-<slug>
 *   Storage Redesign                         └──────────────────────────────┘
 *   Redesigned R2's configuration, …         ⓪ A-101 · COVER
 *   ┌ title block ┐
 *   [ Jump to Prototype ↗ ]  ( Section · ≈ 13 min | Plan · ≈ 5 min )
 *
 * DOM order is the phone order (back · eyebrow · h1 · deck · PLATE · title block · CTA · View), so the image arrives
 * in the first scroll on phones and reading/focus order never jumps; ≥ 1024 the plate is placed in the right-hand
 * track of the same grid (cols 6–12 of the shell), centred on the text column.
 * Words: her eyebrow, title, deck (her description; orbit/educademy: their index line, sheets.ts deckOf), her meta,
 * her CTA labels. Chrome: the back link, "Cover", the title block keys we add (Rev., Sheet) — chrome.wp5.case.
 * The primary CTA is the first `cta` block of her first section (CSBS, Orbit and Educademy have none); PFF's second
 * CTA ("Outcome" → #highlights) is a secondary text link.
 */
import type { CaseStudy } from '../../lib/blocks';
import type { CaseReading } from '../../lib/reading';
import type { CoverPlate } from '../../data/sheets';
import { plateLayers } from '../../data/sheets';
import { chrome, fill } from '../../data/chrome';
import { alt } from '../../data/alt';
import { externalAttrs, isExternal } from '../../lib/rich';
import { keepPhrases } from '../../lib/typeset';
import Plate from '../media/Plate.astro';
import Bubble from '../symbols/Bubble.astro';
import Icon from '../symbols/Icon.astro';
import TitleBlock from './TitleBlock.astro';
import ViewToggle from './ViewToggle.astro';
interface Props { cs: CaseStudy; sheetNo: string; reading: CaseReading; deck: string; cover: CoverPlate }
const { cs, sheetNo, reading, deck, cover } = Astro.props;
const c = chrome.wp5.case;
const firstCta = cs.sections[0]?.blocks.find((b) => b.t === 'cta');
const ctas = firstCta && firstCta.t === 'cta' ? firstCta.items : [];
const [primary, secondary] = ctas;
const layers = plateLayers(cover);
const top = cover.layers[cover.layers.length - 1].file;
// presentation-only: the noun phrases of her titles that a line should not split (lib/typeset.ts keepPhrases; exact
// substrings, textContent unchanged — a phrase no longer in her title is simply ignored)
const TITLE_PHRASES: Record<string, readonly string[]> = {
  cloudflare: ['Cloudflare R2', 'Object Storage'],
  pff: ['approval chain', 'federally funded', 'emergency spending'],
  'u-up': ['Connecting People', 'Shared Experience'],
  orbit: ['Faculty Workload'],
};
---
<header class="case-head" data-case-head>
  <div class="case-head__grid shell">
    <a class="case-head__back t-label" href="/#index"><Icon name="arrow-left" size={14} /><span>{c.back}</span></a>
    <p class="case-head__eyebrow t-label-lg" data-v>{cs.eyebrow}</p>
    <h1 class:list={['case-head__title', 't-title', { 'case-head__title--long': cs.title.length > 44 }]} data-v set:html={keepPhrases(cs.title, TITLE_PHRASES[cs.slug] ?? [])} />
    <p class="case-head__deck t-deck" data-v>{deck}</p>
    <figure class="case-head__plate">
      <Plate
        layers={layers}
        stage={cover.stage}
        aspect={cover.aspect}
        vt={`plate-${cs.slug}`}
        priority="high"
        dims
        alt={alt(top)}
        frame="bare"
        fig={{ no: fill(c.coverFig, { no: sheetNo }) }}
        class="case-head__cover"
      />
      <figcaption class="case-head__cap">
        <Bubble n="0" sheet={sheetNo} />
        <span class="case-head__cap-t t-label">{c.cover}</span>
      </figcaption>
    </figure>
    <TitleBlock cs={cs} sheetNo={sheetNo} reading={reading} />
    <div class="case-head__actions">
      {primary && (
        <a class="btn case-head__cta" href={primary.href} {...externalAttrs(primary.href)}>
          <span data-v>{primary.label}</span><Icon name={isExternal(primary.href) ? 'arrow-up-right' : 'arrow-down'} />
        </a>
      )}
      {secondary && (
        <a class="case-head__second" href={secondary.href} {...externalAttrs(secondary.href)} data-cite-link={isExternal(secondary.href) ? undefined : ''}>
          <span data-v>{secondary.label}</span><Icon name={isExternal(secondary.href) ? 'arrow-up-right' : 'arrow-down'} size={14} />
        </a>
      )}
      <ViewToggle minutes={reading.minutes} planMinutes={reading.planMinutes} class="case-head__view" />
    </div>
  </div>
</header>

<style>
  /* ── the grid: phones stack in DOM order; ≥ 1024 the text takes cols 1–5 of the shell and the plate cols 6–12 ── */
  .case-head {
    padding-block: var(--s-4) var(--s-7);
    --_view-w: 11.5rem; /* the View toggle's fixed width beside her CTA (≥ 768): the same drawn form on every sheet, and
                         narrow enough to sit beside her CTA in the 1024 text column */
  }
  .case-head__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  .case-head__back {
    justify-self: start;
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-block-size: var(--hit); margin-block-end: var(--s-4);
    color: var(--ink-2); text-decoration: none;
  }
  .case-head__back :global(.icon) { transition: transform var(--dur-2) var(--ease-ui); }
  @media (hover: hover) {
    .case-head__back:hover { color: var(--rust-deep); }
    .case-head__back:hover :global(.icon) { transform: translateX(calc(-1 * var(--s-1))); }
  }

  .case-head__eyebrow { color: var(--acc); margin-block-end: var(--s-3); }
  /* WP7: the measure is 16ch of Newsreader 340 at the title's size, written as a length that does not depend on the
     face (1ch ≈ 0.6165em − 1.83px over 38–51px, from its "0" at each optical size): in ch, the fallback face's narrower
     "0" cut the measure by 11 % while the fonts loaded, and the title re-wrapped when they landed (CLS 0.17 on a
     phone). Same breaks as 16ch for every title at every width 320–1023 px, in Newsreader. */
  .case-head__title { max-inline-size: calc(9.864em - 29.2px); text-wrap: balance; }
  /* presentation-only typesetting of her words (lib/typeset.ts keepPhrases; textContent unchanged): a hyphenated
     compound never breaks at its hyphen, and a title breaks between its noun phrases, never inside one (an atomic
     inline-block, which still wraps inside itself when a phrase is wider than the line, so nothing overflows) */
  .case-head__title :global(.nobr) { white-space: nowrap; }
  .case-head__title :global(.keep) { display: inline-block; }
  /* a long title (PFF's is 63 characters) steps the title token down a size, so it sets in three or four lines, not
     five, beside the plate */
  .case-head__title--long { font-size: calc(var(--fs-title) * .82); line-height: 1.04; max-inline-size: calc(10.804em - 21.6px); /* 18ch, as above */ }
  .case-head__deck { color: var(--ink-2); margin-block-start: var(--s-4); max-inline-size: 30em; text-wrap: pretty; }

  .case-head__plate { margin-block: var(--s-6) 0; min-inline-size: 0; }
  /* the plate sits on the paper like a print: its stage runs to the edge, a hairline and the plate shadow lift it */
  .case-head__plate :global(.case-head__cover) { box-shadow: var(--shadow-plate); outline: var(--lw-object) solid var(--line-1); }
  .case-head__cap {
    display: flex; align-items: center; gap: var(--s-3);
    margin-block-start: var(--s-3); color: var(--ink-2);
  }
  .case-head__cap-t { color: var(--ink-2); }

  /* actions (§5.2.1): her CTA(s) and the View toggle on one row — [ Jump to Prototype ↗ ]  ( Section | Plan ). From
     768 the toggle has a fixed width, so every sheet draws it in the same form (SECTION / FULL TEXT / ≈ 13 MIN, the
     rail's stack) whether or not she has a CTA; it takes its own row only when her CTAs leave no room (PFF's two).
     The row's boxes share both edges: the CTA stretches to the toggle's height and centres its label. On phones the
     toggle is a full-width row of its own (label over minutes). The toggle is a size container: its two options lay
     out by its own width, the same way for both (ViewToggle.astro, @container viewtoggle) */
  .case-head__actions {
    display: flex; flex-wrap: wrap; align-items: stretch; gap: var(--s-4);
    margin-block-start: var(--s-5);
  }
  .case-head__actions > :global(.case-head__view) {
    container: viewtoggle / inline-size;
    flex: 1 1 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    .case-head__actions > :global(.case-head__view) { flex: 0 0 var(--_view-w); }
  }
  .case-head__cta { gap: var(--s-2); }
  .case-head__cta :global(.icon) { transition: transform var(--dur-2) var(--ease-ui); }
  @media (hover: hover) {
    .case-head__cta:hover :global(.icon--arrow-up-right) { transform: translate(2px, -2px); }
    .case-head__cta:hover :global(.icon--arrow-down) { transform: translateY(2px); }
  }
  .case-head__second {
    display: inline-flex; align-items: center; gap: var(--s-1); min-block-size: var(--hit);
    font-family: var(--font-sans); font-size: var(--fs-label-lg); font-weight: var(--wt-label-lg);
    font-variation-settings: var(--wdth-label); letter-spacing: .04em;
    color: var(--ink);
  }
  @media (hover: hover) {
    .case-head__second:hover { color: var(--rust-deep); }
  }

  /* tablets: one column; the title block and the actions row run the full content width, like the plate above them,
     so every edge of the header lines up (the 96px key column keeps the values readable) */
  @media (min-width: 1024px) {
    .case-head { padding-block: var(--s-4) var(--s-7); }
    .case-head__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--g);
      /* the last row absorbs the plate when it is taller than the text, so the text rows never stretch */
      grid-template-rows: auto auto auto auto auto auto 1fr;
    }
    .case-head__eyebrow, .case-head__title, .case-head__deck, .case-head__actions, .case-head__grid > :global(.titleblock) { grid-column: 1; }
    .case-head__back { grid-column: 1 / -1; }
    /* the plate is centred on the text column (eyebrow to actions), as in the prototype, so neither track ends in an
       empty quadrant; when the plate is the taller of the two, the last row absorbs it and it fills its area */
    .case-head__plate { grid-column: 2; grid-row: 2 / -1; margin: 0; align-self: center; }
    .case-head__title { max-inline-size: none; }
    .case-head__deck { max-inline-size: none; }
  }
  @media (min-width: 1280px) {
    .case-head__grid { column-gap: calc(var(--g) * 2); }
  }
  /* short laptop windows (1280×720, 1366×768): the whole first layer — title, deck, title block, her CTA and the View
     toggle — stays above the fold: the title steps down one size (as a long title does), the long title one more,
     and the vertical rhythm tightens by one space step */
  @media (min-width: 1024px) and (max-height: 800px) {
    .case-head { padding-block-start: 0; }
    .case-head__back { margin-block-end: var(--s-2); }
    .case-head__eyebrow { margin-block-end: var(--s-2); }
    .case-head__title { font-size: calc(var(--fs-title) * .82); line-height: 1.04; }
    .case-head__title--long { font-size: calc(var(--fs-title) * .72); }
    .case-head__deck { margin-block-start: var(--s-3); }
    .case-head__grid > :global(.titleblock) { margin-block-start: var(--s-3); --titleblock-pad: var(--s-1); --titleblock-pad-sheet: var(--s-2); }
    .case-head__actions { margin-block-start: var(--s-3); row-gap: var(--s-3); }
  }
</style>
