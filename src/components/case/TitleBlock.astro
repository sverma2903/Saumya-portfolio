---
/**
 * TitleBlock · WP5. The case title block, a <dl> drawn like the title block of a drawing sheet (SPEC §5.2.1):
 *   ROLE    Sole designer, Mar 2026          ← her meta rows (Role/Team/Skills, or Timeline/Context), verbatim
 *   TEAM    1 Designer
 *   SKILLS  User Research, Design System, …
 *   REV.    △1 UPDATE — This study examined the dashboard in March 2026.   ← only when a callout is titled "Update"
 *   SHEET   A-101 · 6 levels · ≈ 13 min                                    ← chrome (computed)
 * Borders: outer --lw-border ink, rows --lw-object --line-2, a key column of 96px with its own hairline. The REV. row
 * links to the revision cloud (the callout block's id, e.g. #overview-0). Her values are comma-separated lists: each
 * item is kept whole on its line when it fits (lib/typeset.ts keepItems), so "1 UX Researcher" never splits as
 * "1 / UX Researcher" on a phone.
 */
import Glyphs from '../symbols/Glyphs.astro';
import type { CaseStudy } from '../../lib/blocks';
import type { CaseReading } from '../../lib/reading';
import { blockId } from '../../lib/ids';
import { chrome, fill } from '../../data/chrome';
import RevDelta from '../symbols/RevDelta.astro';
import { keepItems } from '../../lib/typeset';
interface Props { cs: CaseStudy; sheetNo: string; reading: CaseReading }
const { cs, sheetNo, reading } = Astro.props;
let rev: { id: string; title: string; lede: string } | null = null;
for (const s of cs.sections) {
  s.blocks.forEach((b, i) => {
    if (!rev && b.t === 'callout' && b.title === 'Update') rev = { id: blockId(s.id, i), title: b.title, lede: b.lede };
  });
}
const r = rev as { id: string; title: string; lede: string } | null;
const c = chrome.wp5.case;
// "A-101 · 6 levels · ≈ 13 min", set as three atomic items so "≈" never parts from its minutes on a phone
const sheetInfo = fill(c.sheetInfo, { no: sheetNo, n: reading.levels, m: reading.minutes }).split(' · ');
---
<dl class="titleblock">
  {cs.meta.map(([k, v]) => (
    <div class="titleblock__row">
      <dt class="titleblock__k t-label" data-v>{k}</dt>
      <dd class="titleblock__v" data-v set:html={keepItems(v)} />
    </div>
  ))}
  {r && (
    <div class="titleblock__row titleblock__row--rev">
      <dt class="titleblock__k t-label">{c.rev}</dt>
      <dd class="titleblock__v">
        <a class="titleblock__rev" href={`#${r.id}`} data-cite-link>
          <span class="titleblock__delta" data-chrome><RevDelta n={1} size={24} /></span>
          <span class="titleblock__revt"><span class="titleblock__revk t-label-lg" data-v>{r.title}</span><span class="titleblock__dash" aria-hidden="true"> — </span><span class="titleblock__revl" data-v set:html={r.lede} /></span>
        </a>
      </dd>
    </div>
  )}
  <div class="titleblock__row titleblock__row--sheet">
    <dt class="titleblock__k t-label">{c.sheet}</dt>
    <dd class="titleblock__v titleblock__sheet t-code">{sheetInfo.map((part, i) => <>{i > 0 && ' · '}<span class="keep"><Glyphs text={part} /></span></>)}</dd>
  </div>
</dl>

<style>
  .titleblock {
    --_key: var(--s-9);   /* the 96px key column (§5.2.1) */
    --_delta: 24px;       /* the revision △ with its 1: large enough that the numeral reads as a 1, not a "!" */
    margin-block-start: var(--s-5);
    background: var(--sheet);
    border: var(--lw-border) solid var(--ink);
  }
  /* each row: key | value, first baselines aligned; the key column's hairline is drawn by the row itself so it always
     runs the row's full height (baseline alignment turns stretch off) */
  .titleblock__row {
    display: grid; grid-template-columns: var(--_key) minmax(0, 1fr); align-items: baseline;
    border-block-start: var(--lw-object) solid var(--line-2);
    background: linear-gradient(var(--line-2), var(--line-2)) no-repeat var(--_key) 0 / var(--lw-object) 100%;
  }
  .titleblock__row:first-child { border-block-start: 0; }
  /* her comma-separated values break only between items (lib/typeset.ts keepItems; textContent unchanged): an
     inline-block item is atomic on its line, and still wraps inside itself if it is longer than the line */
  .titleblock__v :global(.keep) { display: inline-block; }
  /* row padding: --titleblock-pad (the header tightens it by a step on short windows), else --s-2 */
  .titleblock__k { padding: var(--titleblock-pad, var(--s-2)) var(--s-3); color: var(--ink-2); white-space: nowrap; }
  .titleblock__v {
    margin: 0; padding: var(--titleblock-pad, var(--s-2)) var(--s-4);
    font-size: var(--fs-body-sm); line-height: 1.4; color: var(--ink);
    text-wrap: pretty;
  }

  /* REV. △1 UPDATE — her sentence: one link to the revision cloud, hanging past the delta */
  .titleblock__rev {
    display: block; padding-inline-start: calc(var(--_delta) + var(--s-2)); text-indent: calc(-1 * (var(--_delta) + var(--s-2)));
    color: var(--ink); text-decoration: none;
  }
  .titleblock__delta { display: inline-block; inline-size: var(--_delta); margin-inline-end: var(--s-2); text-indent: 0; vertical-align: -0.2em; color: var(--rust); }
  .titleblock__delta :global(.sym-revdelta) { display: block; }
  .titleblock__revk { color: var(--rust); }
  .titleblock__dash { color: var(--ink-3); }
  .titleblock__revl {
    text-decoration-line: underline; text-decoration-thickness: 1px; text-decoration-color: var(--line-3);
    text-underline-offset: 3px; transition: text-decoration-color var(--dur-1) var(--ease-ui), color var(--dur-1) var(--ease-ui);
  }
  @media (hover: hover) {
    .titleblock__rev:hover .titleblock__revl { color: var(--rust-deep); text-decoration-color: currentColor; }
  }

  @media (max-width: 479.98px) { .titleblock__v { padding-inline: var(--s-3); } }
  .titleblock__v.titleblock__sheet { font-size: var(--fs-code); line-height: var(--lh-code); color: var(--ink-2); padding-block: var(--titleblock-pad-sheet, var(--s-3)); }
</style>
