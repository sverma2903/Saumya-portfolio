---
/**
 * Chapter · WP5. One level of the case (SPEC §5.2.3): <section id={her section id}> with its legacy anchors, the
 * section mark (bubbles 02 / A-101, the dash-dot cut line, her label as h2, LEVEL 02 · +00:36 · ≈ 2 MIN), then her
 * blocks — single blocks through <Block>, feature runs through <FeatureRun> (lib/features.ts groups), and every run
 * of consecutive Plan-view omissions coalesced into one counted break line (<OmitRun>, SM5c).
 *
 * A chapter is its OWN grid with the same tracks as .case-body (text | gap | notes), not a subgrid: content-visibility
 * applies layout containment, and an element with layout containment cannot be a subgrid (P0-NOTES §7.1). Blocks
 * inside stay subgrid rows of the chapter, so notes still align beside their block. Below 1280 the chapter keeps a
 * grid too: the text column is held at the reading measure and wide blocks take the whole column.
 * Chapters after the first skip rendering off-screen (content-visibility: auto; find-in-page and anchors still work).
 */
import type { CaseStudy } from '../../lib/blocks';
import type { ChapterCtx } from '../../lib/blocks-ctx';
import type { SectionReading } from '../../lib/reading';
import { omitLabel } from '../../lib/planview';
import Block from '../blocks/Block.astro';
import FeatureRun from '../blocks/FeatureRun.astro';
import SectionMark from './SectionMark.astro';
import OmitRun from './OmitRun.astro';
import LegacyAnchors from './LegacyAnchors.astro';
interface Props { cs: CaseStudy; chapter: ChapterCtx; level: SectionReading; sheetNo: string }
const { cs, chapter, level, sheetNo } = Astro.props;
const { section, ctxs, plan, groups } = chapter;
type Item = { kind: 'block'; i: number } | { kind: 'run'; renderer: 'phone' | 'player'; indices: number[] } | { kind: 'omit'; indices: number[] };
const items: Item[] = [];
for (const g of groups) {
  if (g.kind === 'run') { items.push({ kind: 'run', renderer: g.renderer, indices: g.indices }); continue; }
  const last = items[items.length - 1];
  if (plan[g.index].mode === 'omit') {
    if (last && last.kind === 'omit') last.indices.push(g.index);
    else items.push({ kind: 'omit', indices: [g.index] });
  } else items.push({ kind: 'block', i: g.index });
}
const counted = (indices: number[]) => indices.some((i) => Object.values(plan[i].omitted ?? {}).some((n) => (n ?? 0) > 0));
---
<section id={section.id} class="chapter" aria-labelledby={`${section.id}-h`} data-chapter={chapter.index}>
  <LegacyAnchors slug={cs.slug} sectionId={section.id} />
  <SectionMark index={chapter.index} id={section.id} label={section.label} sheet={sheetNo} elev={level.elev} minutes={level.minutes} />
  {items.map((it, k) =>
    it.kind === 'block' ? (
      <Block block={section.blocks[it.i]} ctx={ctxs[it.i]} />
    ) : it.kind === 'run' ? (
      <FeatureRun blocks={it.indices.map((i) => section.blocks[i]) as never} ctxs={it.indices.map((i) => ctxs[i])} renderer={it.renderer} />
    ) : (
      <OmitRun id={`${section.id}-omit-${k}`} label={counted(it.indices) ? omitLabel(it.indices.map((i) => plan[i])) : null}>
        {it.indices.map((i) => <Block block={section.blocks[i]} ctx={ctxs[i]} />)}
      </OmitRun>
    ),
  )}
</section>

<style>
  /* The chapter's box runs from the gutter beside the rail to the page edge, so everything a block hangs into the
     gutter (leaders, keynote tags, the citation bracket) or bleeds to the edge stays inside it: content-visibility
     paint-contains the box and would clip it otherwise. Its tracks repeat .case-body's (the side margin via cqi,
     .case-body being the size container), so text and notes sit exactly on the page grid. */
  .chapter {
    position: relative;
    grid-column: gutter-start / full-end;
    display: grid;
    grid-template-columns:
      [gutter-start] minmax(var(--gap), 1fr)
      [text-start] minmax(0, var(--measure)) [text-end] minmax(var(--gap), 1fr)
      [notes-start] var(--notes) [notes-end]
      max(var(--m), calc((100cqi - var(--maxw)) / 2 + var(--m))) [full-end];
    align-content: start;
    margin-block-start: var(--space-chapter);
    /* anchors (#empathize, legacy aliases, J/K) land with the section mark a breath below the bar */
    scroll-margin-block-start: var(--s-5);
    /* belt and braces for engines that honour it: nothing a block draws just outside the box is clipped */
    overflow-clip-margin: var(--s-7);
  }
  .chapter:not(:first-of-type) { content-visibility: auto; contain-intrinsic-size: auto 1400px; }
  /* 1024–1279 and below: one text column held at the reading measure; wide blocks (figures, schedules, runs,
     section marks) take the whole column; notes fold under their block (base.css) */
  @media (max-width: 1279.98px) {
    .chapter {
      grid-template-columns: [gutter-start] var(--gap) [text-start] minmax(0, var(--measure)) [text-end] minmax(0, 1fr) [notes-start notes-end] var(--m) [full-end];
    }
    .chapter > :global(.blk.is-wide),
    .chapter > :global(.omit-run > .omit-run__body > .blk.is-wide) { grid-column: text-start / notes-end; }
  }
  @media (max-width: 1023.98px) {
    .chapter {
      grid-column: full-start / full-end;
      grid-template-columns: [full-start] var(--m) [gutter-start text-start] minmax(0, var(--measure)) [text-end] minmax(0, 1fr) [notes-start notes-end] var(--m) [full-end];
    }
  }
  @media (max-width: 767.98px) {
    .chapter { margin-block-start: var(--s-9); scroll-margin-block-start: var(--s-3); }
  }
</style>
