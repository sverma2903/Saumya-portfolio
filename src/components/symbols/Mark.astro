---
/**
 * Mark · P0 symbol. Her △○□ (24×24): triangle M6 6 L2.25 17.25 L9.75 17.25 Z, circle (14.625, 7.125) r 4.125,
 * rect x 12.75 y 13.5 w 8.25 h 6.75 rx 1. currentColor, 1px stroke at 24px.
 * `construction`: clay dashed construction lines (compass circle, set-square diagonal, baseline) that draw in
 * when an ancestor link/button is hovered or focused (280ms). aria-hidden unless `label` is given.
 */
interface Props {
  size?: number;
  label?: string;
  construction?: boolean;
  strokeWidth?: number;
  class?: string;
}
const { size = 24, label, construction = false, strokeWidth = 1, class: cls } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg class:list={['sym', 'sym-mark', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linejoin="round" focusable="false" {...a11y}>
  {construction && (
    <g class="mark__cons" stroke-width="0.6" stroke-dasharray="1.2 1.2">
      <circle cx="14.625" cy="7.125" r="6.4" />
      <path d="M1.5 21.5 22.5 2.5" />
      <path d="M0.75 17.25H23.25" />
    </g>
  )}
  <path d="M6 6 L2.25 17.25 L9.75 17.25 Z" />
  <circle cx="14.625" cy="7.125" r="4.125" />
  <rect x="12.75" y="13.5" width="8.25" height="6.75" rx="1" />
</svg>
<style>
  .sym-mark { flex: none; overflow: visible; }
  .mark__cons { stroke: var(--clay); opacity: 0; transition: opacity var(--dur-3) var(--ease-draft); }
  :global(:is(a, button):is(:hover, :focus-visible)) .mark__cons { opacity: 1; }
</style>
