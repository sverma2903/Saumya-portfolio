---
/**
 * SectionHead · P0 symbol. A section-cut head: a bubble with the section letter and a solid half-arrow that shows
 * the view direction (Section cut A–A, the hero). currentColor; aria-hidden.
 */
interface Props {
  letter?: string;
  dir?: 'up' | 'down' | 'left' | 'right';
  size?: number;
  class?: string;
}
const { letter = 'A', dir = 'down', size = 44, class: cls } = Astro.props;
const rot = { down: 0, left: 90, up: 180, right: 270 }[dir];
---
<svg class:list={['sym', 'sym-sectionhead', cls]} width={size} height={size * 1.5} viewBox="0 0 44 66" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
  <circle cx="22" cy="22" r="20.4" stroke-width="1.25" />
  <g transform={`rotate(${rot} 22 22)`}>
    <path d="M22 42.4 L22 64 L4 42.4 Z" fill="currentColor" stroke="none" />
  </g>
  <text x="22" y="27.5" text-anchor="middle" fill="currentColor" stroke="none" class="sectionhead__l">{letter}</text>
</svg>
<style>
  .sym-sectionhead { flex: none; overflow: visible; }
  .sectionhead__l { font-family: var(--font-mono); font-size: 15px; font-weight: 500; }
</style>
