---
/** RevDelta · P0 symbol. The revision delta: her △ with the revision number (△1). currentColor; aria-hidden. */
interface Props {
  n?: number | string;
  size?: number;
  class?: string;
}
const { n = 1, size = 22, class: cls } = Astro.props;
---
<svg class:list={['sym', 'sym-revdelta', cls]} width={size} height={size * (21 / 24)} viewBox="0 0 24 21" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
  <path d="M12 1.2 L22.8 19.8 H1.2 Z" stroke-width="1.25" stroke-linejoin="round" />
  <text x="12" y="17" text-anchor="middle" fill="currentColor" stroke="none" class="revdelta__n">{n}</text>
</svg>
<style>
  .sym-revdelta { flex: none; overflow: visible; }
  .revdelta__n { font-family: var(--font-mono); font-size: 11.5px; font-weight: 500; }
</style>
