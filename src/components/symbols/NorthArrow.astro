---
/** NorthArrow · P0 symbol. A split-fill needle in a circle, with N. currentColor; aria-hidden. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: cls } = Astro.props;
---
<svg class:list={['sym', 'sym-north', cls]} width={size} height={size * (52 / 40)} viewBox="0 0 40 52" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
  <text x="20" y="10" text-anchor="middle" fill="currentColor" stroke="none" class="north__n">N</text>
  <circle cx="20" cy="32" r="18" stroke-width="1" />
  <path d="M20 14 L26 38 L20 34 Z" fill="currentColor" stroke-width="0.75" stroke-linejoin="round" />
  <path d="M20 14 L14 38 L20 34 Z" fill="none" stroke-width="0.75" stroke-linejoin="round" />
</svg>
<style>
  .sym-north { flex: none; overflow: visible; }
  .north__n { font-family: var(--font-mono); font-size: 11.5px; font-weight: 500; }
</style>
