---
import Mark from './Mark.astro';
import { links } from '../content/site';
const { current = '', autohide = false } = Astro.props;
---
<header class="nav" data-theme="light" {...(autohide ? { 'data-autohide': '' } : {})}>
  <a class="brand" href="/" aria-label="Saumya Verma, home">
    <Mark class="brand-mark" />
    <span class="brand-name">Saumya Verma</span>
  </a>
  <nav class="nav-links" aria-label="Primary">
    <a href="/#work" aria-current={current === 'work' ? 'page' : undefined}>Work</a>
    <a href="/about" aria-current={current === 'about' ? 'page' : undefined}>About</a>
    <a href="/fun" aria-current={current === 'play' ? 'page' : undefined}>Play</a>
    <a class="ext" href={links.resume} target="_blank" rel="noopener">Resume</a>
  </nav>
</header>
