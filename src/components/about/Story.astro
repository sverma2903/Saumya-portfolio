---
/**
 * Story · OWNER: WP6 (P0 functional stub). "My Story ↓" (her label, h2) and her three paragraphs, each with a clause
 * number B-100.1–.3 (chrome, mono) in the rail column.
 */
import { about, labels } from '../../content/site';
import { chrome, fill } from '../../data/chrome';
---
<section class="story shell" aria-labelledby="story-h">
  <h2 id="story-h" class="t-label-lg" data-v>{labels.story}</h2>
  <ol class="story__list" role="list">
    {about.story.map((s, i) => (
      <li class="story__clause">
        <span class="story__no t-code ink-3" aria-hidden="true">{fill(chrome.wp6.about.clause, { n: i + 1 })}</span>
        <p class="t-body-md" data-v set:html={s} />
      </li>
    ))}
  </ol>
</section>
<style>
  .story { padding-block: var(--s-7); }
  .story__list { list-style: none; padding: 0; display: grid; gap: var(--s-5); margin-block-start: var(--s-4); }
  .story__clause { display: grid; grid-template-columns: 6rem minmax(0, 680px); gap: var(--s-4); }
  @media (max-width: 767.98px) { .story__clause { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); } }
</style>
