---
/**
 * Story · WP6 (SPEC §5.3). "My Story ↓" (her label, the h2) and her three paragraphs as numbered clauses:
 * the clause number `B-100.1–.3` (chrome, Plex Mono, aria-hidden — the <ol> numbers them for assistive tech) stands in
 * the rail on her first line's baseline, and a clay leader with a dot terminal (the leader of her Issuu sheets) carries
 * it across the gutter to her paragraph (--fs-body-md, ink) on the text axis, at the reading measure.
 * Below 1024px the number stands above its paragraph and the leader is dropped.
 */
import { about, labels } from '../../content/site';
import { chrome, fill } from '../../data/chrome';
import { slugify } from '../../lib/text';
import Section from './Section.astro';
const id = slugify(labels.story); // 'my-story'
---
<Section id={id} label={labels.story} class="story">
  <ol class="story__list">
    {about.story.map((s, i) => (
      <li class="story__clause">
        <span class="story__no t-code" aria-hidden="true">{fill(chrome.wp6.about.clause, { n: i + 1 })}</span>
        <p class="story__p" data-v set:html={s} />
      </li>
    ))}
  </ol>
</Section>
<style>
  .story__list {
    grid-column: rail-start / notes-end;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--s-6);
    list-style: none;
    padding: 0;
  }
  .story__clause {
    grid-column: rail-start / notes-end;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
  }
  /* number · leader · dot, from the rail to one --s-4 short of the text axis */
  .story__no {
    grid-column: rail-start / text-start;
    display: flex;
    align-items: center;
    padding-inline-end: var(--s-4);
    color: var(--ink-2);
  }
  .story__no::after {
    content: '';
    flex: 1 1 auto;
    block-size: var(--s-2);
    margin-inline-start: var(--s-4);
    background:
      radial-gradient(circle closest-side, var(--clay) 72%, transparent 100%) right center / var(--s-2) var(--s-2) no-repeat,
      linear-gradient(var(--clay), var(--clay)) left center / calc(100% - var(--s-1)) var(--lw-object) no-repeat;
  }
  .story__p {
    grid-column: text;
    max-inline-size: var(--measure);
    font-size: var(--fs-body-md);
    line-height: var(--lh-body-md);
    color: var(--ink);
  }
  @media (max-width: 1023.98px) {
    .story__list { row-gap: var(--s-5); }
    .story__clause { display: block; }
    .story__no { display: block; margin-block-end: var(--s-2); padding: 0; }
    .story__no::after { content: none; }
  }
</style>
