---
/**
 * Portrait · WP6 (SPEC §5.3). Her 904×904 portrait PNG with its tilted rust card baked in — shown as-is: no extra
 * rotation, no clipping, no filter, no second card. 460px on desktop, ≤ 360px on phones. LCP: preloaded by the page
 * (lcpImage) and fetchpriority=high on the <img>.
 *
 * Behind it, a compass construction in clay: the circle a compass swings to draw the ○ of her △○□ (r = 0.62 · size,
 * 1px dashed) and two centre lines (long–short dash) crossing at the portrait's centre, overshooting the circle a
 * little as construction lines do. Her card's transparent corners let the construction pass behind it. On hover (fine
 * pointers) the portrait itself is dimensioned: extension lines drop from its left and right edges to a dimension line
 * under the circle that reads the file's native width, `904 PX` — the same drafting as the cover plates' dimension
 * strings. (It dimensions the image, not the circle: the circle is 1.24 × the portrait and is not 904 of anything.)
 * It is not an Enlarged-detail figure: a portrait is an avatar (§6.2 zoom rule), and 904px is its size here already.
 * Everything we draw is aria-hidden; the <img> carries the alt text.
 *
 * Sizing: ≥ 1024 the whole construction (1.34 × the portrait) fits its column, so it never crosses her headline;
 * below 1024 the portrait is max 360px and never more than the column / 1.24, so the circle stays inside the column
 * and only the centre lines' overshoot (0.05 · size each side) reaches into the side gutters — never off the screen.
 */
import { about } from '../../content/site';
import { alt } from '../../data/alt';
import { chrome, fill } from '../../data/chrome';
import { facts, fileOf } from '../../lib/staging';
import Plate from '../media/Plate.astro';
const f = facts(about.portrait);
const dia = fill(chrome.wp6.about.diameter, { w: f.w });
const P = 500; // the portrait's half-width in units (its edges are C ± P)
// Drawn in a 1340-unit box whose middle 1000 units are the portrait (1 unit = size / 1000). U turns a screen length at
// the desktop size (460px) into units, so strokes and dashes read as drawn at 1:1 there.
const U = 1000 / 460;
const C = 670; // centre
const r = 620; // 0.62 · size
const dash = `${(4 * U).toFixed(1)} ${(5 * U).toFixed(1)}`;
const center = [14, 3, 2, 3].map((n) => (n * U).toFixed(1)).join(' ');
const sw = U.toFixed(2);
const tick = 6 * U;
const yDim = C + r + 28 * U; // the dimension line, 28px under the circle
const gap = 4 * U; // extension lines start this far below the portrait's foot (a drafting gap)
---
<figure class="portrait">
  <svg class="portrait__cons" viewBox="0 0 1340 1340" aria-hidden="true" focusable="false">
    <circle cx={C} cy={C} r={r} fill="none" stroke="currentColor" stroke-width={sw} stroke-dasharray={dash} />
    <path d={`M0 ${C}H1340M${C} 0V1340`} fill="none" stroke="currentColor" stroke-width={sw} stroke-dasharray={center} />
    <g class="portrait__dim" fill="none" stroke="currentColor" stroke-width={sw}>
      {[C - P, C + P].map((x) => <path class="portrait__ext" pathLength="1" d={`M${x} ${C + P + gap}V${yDim + 8 * U}`} />)}
      <path class="portrait__line" pathLength="1" d={`M${C - P} ${yDim}H${C + P}`} />
      {[C - P, C + P].map((x) => <path class="portrait__ticks" pathLength="1" d={`M${x - tick} ${yDim + tick}L${x + tick} ${yDim - tick}`} />)}
    </g>
  </svg>
  <span class="portrait__label t-code-sm" aria-hidden="true" style={`--_y: ${((yDim - C) / 10 + 50).toFixed(2)}%`}>{dia}</span>
  <Plate layers={[about.portrait]} alt={alt(fileOf(about.portrait))} frame="bare" priority="high" class="portrait__plate" />
</figure>
<style>
  .portrait {
    --_s: min(460px, 100% / 1.34);
    position: relative;
    isolation: isolate;
    inline-size: var(--_s);
    justify-self: center;
    /* room for the construction: the centre lines reach 0.17 · size beyond the portrait */
    margin-block: calc(0.17 * var(--_s));
  }
  .portrait__cons {
    position: absolute;
    inset: -17%;
    inline-size: 134%;
    block-size: 134%;
    max-inline-size: none;
    z-index: -1;
    color: var(--clay);
    overflow: visible;
    pointer-events: none;
  }
  /* the dimension is drawn as a pen draws it (§2.7: dimension strings draw over --dur-3, on --ease-draft): the two
     extension lines drop from the portrait's edges, then the dimension line runs between them, its ticks struck and
     the figure written at the end. Leaving, it fades as one (--dur-1) and is wound back unseen. Reduced motion: the
     duration tokens are ~0, so it simply appears. */
  .portrait__dim { opacity: 0; transition: opacity var(--dur-1) var(--ease-ui); }
  .portrait__dim path {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0s linear var(--dur-1);
  }
  .portrait__label { opacity: 0; transition: opacity var(--dur-1) var(--ease-ui); }
  .portrait__label {
    position: absolute;
    inset-block-start: var(--_y);
    inset-inline-start: 50%;
    translate: -50% -50%;
    padding: 0 var(--s-2);
    background: var(--paper);
    color: var(--ink-2);
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .portrait:hover .portrait__dim { opacity: 1; transition-duration: 0s; }
    .portrait:hover .portrait__dim path { stroke-dashoffset: 0; transition: stroke-dashoffset calc(var(--dur-3) / 2) var(--ease-draft) 0s; }
    .portrait:hover .portrait__dim .portrait__line { transition-delay: calc(var(--dur-3) / 2); }
    .portrait:hover .portrait__dim .portrait__ticks { transition-duration: var(--dur-1); transition-delay: var(--dur-3); }
    .portrait:hover .portrait__label { opacity: 1; transition-delay: var(--dur-3); }
  }
  @media (max-width: 1023.98px) {
    /* under the button: the construction's top centre line stops short of it instead of touching it */
    .portrait { --_s: min(360px, 100% / 1.24); margin-block-start: calc(0.17 * var(--_s) + var(--s-5)); }
  }
  @media (forced-colors: active) {
    .portrait__cons { color: CanvasText; }
  }
  @media print {
    .portrait__dim, .portrait__label { display: none; }
  }
</style>
