---
/**
 * Meditation · WP6 (SPEC §5.3). The stillest block on the site: her title (detail 3 / B-100), then a quiet field
 * (≥ 60vh) holding only her 512px image at 200px (its staging cap) and her one line beneath it, hung from the text axis (the page's one vertical line).
 * `data-still`: no hover effect, no motion, no enlarge affordance — nothing here moves or asks for anything.
 */
import { about } from '../../content/site';
import { alt } from '../../data/alt';
import { facts, fileOf, stagingOf } from '../../lib/staging';
import { slugify } from '../../lib/text';
import Plate from '../media/Plate.astro';
import LoveTitle from './LoveTitle.astro';
const md = about.loves.meditation;
const id = slugify(md.title); // 'meditation'
const w = stagingOf(md.img).cap ?? facts(md.img).w; // 200 (media-staging cap for this 512px file)
---
<article class="love love--still" id={id} aria-labelledby={`${id}-h`} data-still>
  <LoveTitle n={3} id={id} title={md.title} />
  <div class="still">
    <div class="still__img" style={`--_w: ${w}px`}><Plate layers={[md.img]} alt={alt(fileOf(md.img))} frame="bare" /></div>
    <p class="still__p" data-v set:html={md.text} />
  </div>
</article>
<style>
  .love {
    grid-column: rail-start / notes-end;
    display: grid;
    grid-template-columns: subgrid;
    align-content: start;
  }
  /* the quiet field is the band's full height; what it holds hangs from the text axis, as every other love does */
  .still {
    grid-column: text;
    min-block-size: 60svh;
    display: grid;
    align-content: center;
    justify-content: start;
    justify-items: start;
    gap: var(--s-6);
    padding-block: var(--s-8);
  }
  .still__img { inline-size: var(--_w); max-inline-size: 100%; }
  .still__p {
    font-size: var(--fs-body-md);
    line-height: var(--lh-body-md);
    color: var(--ink-2);
    text-wrap: balance;
  }
  /* phones: a 60svh field centred a 200px image a screen away from its title and read as a missing figure (mobile
     r1); here the stillness is the air after her line, and the image hangs from the title like every other love's */
  @media (max-width: 767.98px) {
    .still { gap: var(--s-5); min-block-size: 0; align-content: start; padding-block: var(--s-5) var(--s-8); }
  }
</style>
