---
/**
 * Writing · WP6 (SPEC §5.3). Blog & Writing: her title (detail 2 / B-100), her text, her "published at" line (her
 * links as authored, new tab) and her three posts as a reference list:
 *
 *   [1]  Cloudflare R2 Object Storage Redesign ↗ ······························· MEDIUM.COM
 *   [2]  Making Visual Data Accessible ↗ ······································· MEDIUM.COM
 *   [3]  Search SUGAR ↗ ·························································· MEDIUM.COM
 *
 * Fidelity: her three titles stay adjacent in the page text (only tags between them), exactly as in her original
 * block. So every piece of chrome here is CSS generated content with empty alt text (`content: … / ""`): the [n]
 * counters, the derived domain (from `data-domain`); the ↗ is an aria-hidden SVG (no text node).
 * The "Making Visual Data Accessible" link answers 410 today: it is kept as authored and flagged to the owner (§8.9).
 */
import { about } from '../../content/site';
import { externalAttrs, rich } from '../../lib/rich';
import { domainOf, slugify } from '../../lib/text';
import Icon from '../symbols/Icon.astro';
import LoveTitle from './LoveTitle.astro';
const w = about.loves.writing;
const id = slugify(w.title); // 'blog-writing'
---
<article class="love" id={id} aria-labelledby={`${id}-h`}>
  <LoveTitle n={2} id={id} title={w.title} />
  <div class="love__body">
    <p class="love__p" data-v set:html={w.text} />
    <p class="love__p" data-v set:html={rich(w.published)} />
  </div>
  <ol class="refs" role="list">
    {w.posts.map((p) => (
      <li class="ref" data-domain={domainOf(p.href)}>
        <a class="ref__a" href={p.href} {...externalAttrs(p.href)} data-v>{p.title}<span class="ref__i" aria-hidden="true" data-chrome><Icon name="arrow-up-right" size={14} /></span></a>
      </li>
    ))}
  </ol>
</article>
<style>
  .love {
    grid-column: rail-start / notes-end;
    display: grid;
    grid-template-columns: subgrid;
    align-content: start;
  }
  .love__body { grid-column: text; max-inline-size: var(--measure); margin-block-start: var(--s-5); display: grid; gap: 1.1em; }
  .love__p { color: var(--ink-2); }

  /* ---------- the reference list ---------- */
  /* the list keeps to her text's measure, so each post's domain stands at the paragraphs' right edge, one gutter from
     the longest title (the section has one right edge; only the shelf board runs on to the sheet's edge) */
  .refs {
    grid-column: text-start / notes-end;
    max-inline-size: var(--measure);
    margin-block-start: var(--s-7);
    padding: 0;
    list-style: none;
    counter-reset: ref;
    border-block-start: var(--lw-object) solid var(--line-2);
  }
  .ref {
    counter-increment: ref;
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-block-end: var(--lw-object) solid var(--line-1);
    transition: background-color var(--dur-1) var(--ease-ui);
  }
  /* [n] hangs in the gutter, left of the text axis (its own column below 1024px) */
  .ref::before {
    content: '[' counter(ref) ']' / '';
    position: absolute;
    inset-inline-end: calc(100% + var(--s-4));
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    letter-spacing: var(--tr-code);
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }
  .ref::after {
    content: attr(data-domain) / '';
    margin-inline-start: auto;
    padding-inline-start: var(--s-5);
    font-family: var(--font-mono);
    font-size: var(--fs-code-sm);
    letter-spacing: var(--tr-code-sm);
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .ref__a {
    font-family: var(--font-serif);
    font-size: var(--fs-lede-sm);
    font-weight: var(--wt-index);
    line-height: var(--lh-index);
    letter-spacing: var(--tr-index);
    color: var(--ink);
    text-decoration: none;
  }
  /* the whole row is the link's target */
  .ref__a::after { content: ''; position: absolute; inset: 0; }
  .ref__i { display: inline-flex; margin-inline-start: var(--s-2); color: var(--rust); vertical-align: 0.05em; }
  @media (hover: hover) {
    .ref:hover { background: var(--sheet); }
    .ref:hover .ref__a { color: var(--rust-deep); }
  }
  .ref:has(.ref__a:focus-visible) { background: var(--sheet); }

  @media (max-width: 1023.98px) {
    .ref { padding-inline-start: calc(var(--s-7) - var(--s-2)); }
    .ref::before { inset-inline: 0 auto; }
  }
  @media (max-width: 767.98px) {
    .ref { flex-wrap: wrap; row-gap: var(--s-1); }
    .ref::after { flex-basis: 100%; margin-inline-start: 0; padding-inline-start: 0; }
  }
</style>
