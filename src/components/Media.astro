---
import type { Media } from '../lib/blocks';
interface Props {
  media: Media;
  alt?: string;
  eager?: boolean;
  class?: string;
  fit?: boolean;
}
const { media, alt = '', eager = false, class: cls, fit = false } = Astro.props;
const style = fit ? 'width:100%;height:100%;object-fit:cover' : undefined;
---
{media.kind === 'video' ? (
  <video
    class={cls}
    src={media.src}
    width={media.w || undefined}
    height={media.h || undefined}
    muted
    loop
    playsinline
    preload={eager ? 'auto' : 'none'}
    data-autoplay
    aria-label={alt || undefined}
    style={style}
  />
) : (
  <img
    class={cls}
    src={media.src}
    width={media.w}
    height={media.h}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
    style={style}
  />
)}
