---
/**
 * Cta · WP4a (SPEC §6.2 `cta`). <p class="cta-row"> with one <a class="btn cta" data-v> per item: her label in her
 * casing (Plex Sans 560, wdth 85, 13px, .04em), a --lw-border ink frame on --sheet, min 44px tall, and an Icon —
 * ↗ for external links (new tab, described by #sv-newtab), ↓ for in-page links. Hover: the blush hatch slides in
 * (background-position, --dur-3). Pointer clicks on in-page links scroll smoothly when Motion is on (§4.9);
 * keyboard activation keeps the native instant jump. Either way focus moves to the destination (Tab continues there). Print: WP1 prints the URL of `a.cta[href^=http]`.
 * Plan view: keep.
 */
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { externalAttrs, isExternal } from '../../lib/rich';
import Icon from '../symbols/Icon.astro';
interface Props { block: Extract<Block, { t: 'cta' }>; ctx: BlockCtx }
const { block, ctx } = Astro.props;
---
<div {...blkAttrs('cta', ctx)}>
  <p class="blk__main cta-row">
    {block.items.map((it) => {
      const ext = isExternal(it.href);
      return (
        <a class="btn cta" href={it.href} {...externalAttrs(it.href)} data-v data-inpage={it.href.startsWith('#') ? '' : undefined}>{it.label}<Icon name={ext ? 'arrow-up-right' : 'arrow-down'} /></a>
      );
    })}
  </p>
  <script>
    // inside the block root: a script rendered between blocks would break the .blk + .blk rhythm (base.css)
    import { focusNoScroll, scrollToEl } from '../../scripts/core/dom';
    // Pointer-initiated in-page CTAs scroll smoothly when Motion is on; keyboard (detail === 0) keeps the native jump.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a.cta[data-inpage]');
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.detail === 0) return;
      const id = decodeURIComponent(a.hash.slice(1));
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      e.preventDefault();
      history.pushState(null, '', `#${id}`);
      scrollToEl(target);
      // as a native fragment jump would: the next Tab continues from the destination, not from this CTA
      focusNoScroll(target);
    });
  </script>
</div>
<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
  }
  /* the base .btn look (base.css) + the blush hatch sliding in from the left on hover */
  .btn {
    background:
      linear-gradient(90deg, transparent 50%, var(--sheet) 50%) 100% 0 / 200% 100% no-repeat,
      var(--hatch-blush),
      var(--sheet);
    transition:
      background-position var(--dur-3) var(--ease-ui),
      color var(--dur-1) var(--ease-ui);
  }
  .btn:hover { background-position: 0 0; color: var(--rust-deep); }
  .btn:active { background-position: 0 0; }
  .btn :global(.icon) { transition: transform var(--dur-3) var(--ease-pen); }
  .btn:hover :global(.icon--arrow-up-right) { transform: translate(1px, -1px); }
  .btn:hover :global(.icon--arrow-down) { transform: translateY(2px); }
  @media (forced-colors: active) { .btn { background: ButtonFace; border-color: ButtonText; } }
</style>
