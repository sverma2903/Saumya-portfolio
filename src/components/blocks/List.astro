---
/**
 * List · OWNER: WP4a (P0 functional stub). Unnumbered → leader list <ul class="leaders">; numbered → keynotes
 * <ol class="keynotes">. Each <li data-v>. Plan view skim: only items with her bold, as <strong data-v> pieces,
 * then "+ N items omitted" (chrome, ink-3).
 */
import Icon from '../symbols/Icon.astro';
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { rich } from '../../lib/rich';
import { chrome, fill } from '../../data/chrome';
interface Props { block: Extract<Block, { t: 'list' }>; ctx: BlockCtx }
const { block, ctx } = Astro.props;
const Tag = block.numbered ? 'ol' : 'ul';
const cls = block.numbered ? 'keynotes' : 'leaders';
const skim = ctx.plan.mode === 'skim' ? (ctx.plan.skimItems ?? []) : null;
const dropped = ctx.plan.dropped ?? 0;
---
<div {...blkAttrs('list', ctx)}>
  <div class="blk__main">
    <Tag class:list={[cls, 't-body', 'ink-2', { full: !!skim }]}>
      {block.items.map((it) => <li data-v set:html={rich(it)} />)}
    </Tag>
    {skim && (
      <Tag class={`${cls} skim t-body ink-2`}>
        {skim.map((pieces) => <li>{pieces.map((s, j) => <>{j > 0 && <span class="skim__join" data-chrome data-join aria-hidden="true"> <Icon name="ellipsis" /> </span>}<strong data-v set:html={s} /></>)}</li>)}
      </Tag>
    )}
    {skim && dropped > 0 && <p class="skim list__dropped t-label ink-3" data-chrome>{fill(chrome.wp5.plan.itemsOmitted, { n: dropped })}</p>}
  </div>
</div>
<style>
  li + li { margin-block-start: var(--s-3); }
  .skim__join { color: var(--clay); }
</style>
