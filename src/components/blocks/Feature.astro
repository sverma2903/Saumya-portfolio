---
/**
 * Feature · OWNER: WP4b (P0 functional stub). One feature, rendered by the renderer lib/features.ts chose:
 *   stacked (desktop capture): head (her kicker as a tag, or her `n` as a keynote), title h{ctx.hl}, lede, html,
 *            items, then the figure WIDE in its staging frame (Cloudflare W4 → Compare, SM6a)
 *   split:   text 5/12 + figure 7/12 (flip swaps the visual order only; DOM order is text, then media)
 * Plan view: keep kicker, title, lede, media; html/items → .plan-hide.
 */
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { singleRenderer, type SingleRenderer } from '../../lib/features';
import { rich } from '../../lib/rich';
import { fileOf, stagingOf } from '../../lib/staging';
import { m } from '../../lib/blocks';
import { alt } from '../../data/alt';
import Plate from '../media/Plate.astro';
import Compare from '../media/Compare.astro';
interface Props { block: Extract<Block, { t: 'feature' }>; ctx: BlockCtx; renderer?: SingleRenderer }
const { block, ctx, renderer } = Astro.props;
const r = renderer ?? singleRenderer(block);
const Tag = `h${ctx.hl}` as 'h3' | 'h4';
const compare = block.media.length === 1 ? stagingOf(block.media[0]).compare : undefined;
---
<div {...blkAttrs('feature', ctx, `feature--${r}${block.flip ? ' feature--flip' : ''}`)} data-renderer={r}>
  <div class="blk__main feature">
    <div class="feature__text">
      {block.n && <span class="feature__n t-code" data-v>{block.n}</span>}
      {block.kicker && <p class="feature__kicker t-code rust" data-v>{block.kicker}</p>}
      {block.title && <Tag class="feature__title t-h" data-v set:html={rich(block.title)} />}
      {block.lede && <p class="feature__lede t-lede-sm" data-v set:html={rich(block.lede)} />}
      {block.html && <p class="feature__html t-body ink-2 plan-hide" data-v set:html={rich(block.html)} />}
      {block.items && block.items.length > 0 && <ul class="feature__items leaders t-body ink-2 plan-hide">{block.items.map((it) => <li data-v set:html={rich(it)} />)}</ul>}
    </div>
    {block.media.length > 0 && (
      <figure class="feature__media">
        {compare ? (
          <Compare final={block.media[0]} under={m(compare.under)} alt={alt(fileOf(block.media[0]))} />
        ) : (
          block.media.map((mm) => <Plate layers={[mm]} alt={alt(fileOf(mm))} fig={ctx.fig ? { no: ctx.fig } : undefined} />)
        )}
        {ctx.fig && <figcaption class="t-code ink-2" data-chrome>{ctx.fig}</figcaption>}
      </figure>
    )}
  </div>
</div>
<style>
  .feature { display: grid; gap: var(--s-5); }
  .feature--split .feature { grid-template-columns: 5fr 7fr; align-items: center; }
  .feature--split.feature--flip .feature__media { order: -1; }
  @media (max-width: 767.98px) {
    .feature--split .feature { grid-template-columns: minmax(0, 1fr); }
    .feature--split.feature--flip .feature__media { order: 0; }
  }
  .feature__text { display: grid; gap: var(--s-3); align-content: start; }
  .feature__media { display: grid; gap: var(--s-2); }
</style>
