---
/**
 * RevisionCloud · WP4a (SPEC SM6b). Her "Update" callout drawn as what it is in a drawing set: a scalloped revision
 * cloud (rust --lw-border stroke, --blush fill at 55%) with the delta △1 at its top-left corner.
 *  - The cloud is generated by scripts/case/revcloud.ts (seeded jitter, ResizeObserver, drawn once at ≥ 40% visible).
 *  - Without JS: a plain ruled box (a rust outline, html:not(.js) only); print: always the finished cloud.
 *  - role="note", named "Rev. 1 Update" (sr-only chrome + her title). The case title block's "REV. △1" row (WP5) links
 *    to this block's id (ctx.id).
 * Her title / lede / html render verbatim, each in its own data-v element. Plan view: keep.
 */
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { rich } from '../../lib/rich';
import { chrome, fill } from '../../data/chrome';
import RevDelta from '../symbols/RevDelta.astro';
interface Props { block: Extract<Block, { t: 'callout' }>; ctx: BlockCtx; n?: number }
const { block, ctx, n = 1 } = Astro.props;
const tid = `${ctx.id}-title`;
const rid = `${ctx.id}-rev`;
---
<div {...blkAttrs('callout', ctx, 'revcloud')}>
  <div class="blk__main rev" role="note" aria-labelledby={`${rid} ${tid}`} data-revcloud data-seed={ctx.id}>
    <svg class="rev__cloud" aria-hidden="true" focusable="false"><path class="rev__fill" /><path class="rev__line" pathLength="1" /></svg>
    <span class="rev__delta" aria-hidden="true"><RevDelta n={n} size={26} /></span>
    <span class="sr-only" id={rid}>{fill(chrome.wp4a.revNo, { n })}</span>
    <p class="rev__t" id={tid} data-v>{block.title}</p>
    <p class="rev__lede" data-v set:html={rich(block.lede)} />
    <p class="rev__html" data-v set:html={rich(block.html)} />
  </div>
  <script>
    // inside the block root: a script rendered between blocks would break the .blk + .blk rhythm (base.css)
    import { initRevClouds } from '../../scripts/case/revcloud';
    initRevClouds();
  </script>
</div>
<style>
  /* the cloud runs --_out + its scallops (≈ 17px) outside the box: give that back to the rhythm around it */
  .revcloud { margin-block: var(--s-4); }
  .rev {
    --_out: calc(var(--s-2) + var(--s-1) / 2);                       /* SPEC SM6b: the cloud runs this far outside the box (revcloud.ts) */
    --_dh: calc(var(--s-3) + var(--lw-object));                        /* half the △1 delta (26px): centres it on the cloud's corner */
    position: relative;
    padding: var(--s-4) var(--s-5) var(--s-5);
  }
  /* no JS: a plain ruled box. An outline (no layout), and only without JS, so it never flashes before the cloud. */
  :global(html:not(.js)) .rev { outline: var(--lw-border) solid var(--rust); outline-offset: calc(-1 * var(--lw-border)); }

  .rev__cloud {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .rev__fill { fill: var(--blush); fill-opacity: 0.55; stroke: none; }
  .rev__line {
    fill: none;
    stroke: var(--rust);
    stroke-width: var(--lw-border);
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .rev.is-pending .rev__line { stroke-dashoffset: 1; }
  .rev.is-pending .rev__fill { opacity: 0; }
  .rev.is-drawn .rev__line { transition: stroke-dashoffset var(--dur-6) var(--ease-draft); }
  /* SM6b: the wash comes 400ms after the draw (--dur-6 × 1.25 = 1600 + 400ms): the pen visibly encloses the note first */
  .rev.is-drawn .rev__fill { transition: opacity var(--dur-4) var(--ease-ui) calc(var(--dur-6) * 1.25); }
  .rev.is-static :is(.rev__line, .rev__fill) { transition: none; }

  /* △1 sits on the cloud's top-left corner, masking the line under it */
  .rev__delta {
    position: absolute;
    inset-block-start: calc(-1 * var(--_out) - var(--_dh));
    inset-inline-start: calc(-1 * var(--_out) - var(--_dh));
    display: flex;
    color: var(--rust);
    line-height: 0;
  }
  .rev__delta :global(svg path) { fill: var(--paper); }
  :global(html:not(.js)) .rev__delta { inset-block-start: calc(-1 * var(--_dh)); inset-inline-start: calc(-1 * var(--_dh)); }   /* on the box's corner */

  .rev__t {
    font-family: var(--font-sans);
    font-size: var(--fs-label-lg);
    font-weight: var(--wt-label-lg);
    line-height: var(--lh-label-lg);
    letter-spacing: var(--tr-label-lg);
    font-variation-settings: var(--wdth-label);
    text-transform: uppercase;
    color: var(--rust);
  }
  .rev__lede {
    margin-block-start: var(--s-2);
    font-family: var(--font-serif);
    font-size: var(--fs-body);
    font-weight: var(--wt-index);      /* 420 */
    line-height: var(--lh-lede);
    color: var(--ink);
    text-wrap: pretty;
  }
  .rev__html {
    margin-block-start: var(--s-2);
    font-family: var(--font-serif);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .rev__t, .rev__lede, .rev__html { position: relative; }   /* above the cloud's fill */

  @media (max-width: 767.98px) {
    /* phones: the callout is inset by --s-2 and the cloud runs 2px out, so its outermost scallop (≈ 2 + 6 + stroke)
       stays ≈ 15px from the screen edge instead of crowding it */
    .rev { --_out: calc(var(--s-1) / 2); margin-inline: var(--s-2); padding: var(--s-4) var(--s-4) var(--s-4) var(--s-5); }
    .rev__delta { inset-block-start: calc(-1 * var(--_out) - var(--_dh)); inset-inline-start: calc(-1 * var(--_out) - var(--s-1)); }   /* stays on-screen */
  }
  @media print {
    .rev__line { stroke-dashoffset: 0 !important; }
    .rev__fill { opacity: 1 !important; }
    /* the cloud (≈ 19px) and its △ (≈ 23px) run outside the note's box, and page breaks ignore overflow: the block's
       own box holds them in print, so a break under the note never paints its scallops over the next page's first
       line (integration: /cloudflare printed the cloud's foot over "Opportunity") */
    .revcloud { margin-block: 0; padding-block: var(--s-5); break-inside: avoid; }
  }
  @media (forced-colors: active) {
    .rev__fill { fill: none; }
    .rev__line { stroke: CanvasText; }
    .rev__delta :global(svg path) { fill: Canvas; }
  }
</style>
