---
/**
 * RevisionCloud · OWNER: WP4a (P0 functional stub). Her "Update" callout drawn as a drafting revision: a scalloped
 * cloud (rust 1.25px, --blush fill at 55%) with △1 at its top-left (SM6b; scripts/case/revcloud.ts draws it).
 * The case title block's "REV. △1" row links to this block's id (ctx.id). P0: a ruled box with △1.
 */
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { rich } from '../../lib/rich';
import RevDelta from '../symbols/RevDelta.astro';
interface Props { block: Extract<Block, { t: 'callout' }>; ctx: BlockCtx }
const { block, ctx } = Astro.props;
---
<div {...blkAttrs('callout', ctx, 'revcloud')}>
  <div class="blk__main callout callout--rev">
    <span class="revcloud__delta rust" data-chrome><RevDelta n={1} /></span>
    <p class="callout__t t-label-lg rust" data-v>{block.title}</p>
    <p class="callout__lede" data-v set:html={rich(block.lede)} />
    <p class="callout__html t-body ink-2" data-v set:html={rich(block.html)} />
  </div>
</div>
<style>
  .callout--rev { border: var(--lw-border) solid var(--rust); padding: var(--s-5); position: relative; }
</style>
