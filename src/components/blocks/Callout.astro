---
/**
 * Callout · WP4a (SPEC §6.2 `callout`, SM6b). title === 'Update' → the Revision cloud. Otherwise a General note: a
 * --lw-border ink box, her title in --fs-label-lg rust, her lede in Newsreader 420 at ≈ 20px (ink), her html in
 * --fs-body (ink-2). role="note", named by her title. Plan view: keep.
 */
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { rich } from '../../lib/rich';
import RevisionCloud from './RevisionCloud.astro';
interface Props { block: Extract<Block, { t: 'callout' }>; ctx: BlockCtx }
const { block, ctx } = Astro.props;
const tid = `${ctx.id}-title`;
---
{block.title === 'Update' ? (
  <RevisionCloud block={block} ctx={ctx} />
) : (
  <div {...blkAttrs('callout', ctx, 'note')}>
    <div class="blk__main callout" role="note" aria-labelledby={tid}>
      <p class="callout__t" id={tid} data-v>{block.title}</p>
      <p class="callout__lede" data-v set:html={rich(block.lede)} />
      <p class="callout__html" data-v set:html={rich(block.html)} />
    </div>
  </div>
)}
<style>
  .callout {
    padding: var(--s-4) var(--s-5) var(--s-5);
    border: var(--lw-border) solid var(--ink);
    background: var(--sheet);
  }
  .callout__t {
    font-family: var(--font-sans);
    font-size: var(--fs-label-lg);
    font-weight: var(--wt-label-lg);
    line-height: var(--lh-label-lg);
    letter-spacing: var(--tr-label-lg);
    font-variation-settings: var(--wdth-label);
    text-transform: uppercase;
    color: var(--rust);
  }
  .callout__lede {
    margin-block-start: var(--s-2);
    font-family: var(--font-serif);
    font-size: var(--fs-body);
    font-weight: var(--wt-index);
    line-height: var(--lh-lede);
    color: var(--ink);
    text-wrap: pretty;
  }
  .callout__html {
    margin-block-start: var(--s-2);
    font-family: var(--font-serif);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
    text-wrap: pretty;
  }
</style>
