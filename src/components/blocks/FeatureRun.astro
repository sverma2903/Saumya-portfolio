---
/**
 * FeatureRun · WP4b (SPEC §6.2 `feature`). A run of consecutive features grouped by lib/features.ts:
 *   renderer 'phone'  → WalkthroughPhone  (U-Up and Educademy overviews: one sticky phone on the --stage panel)
 *   renderer 'player' → WalkthroughPlayer (PFF Highlights: a vertical tablist of her full ledes + one BRW player)
 * Props: { blocks, ctxs, renderer }. Every member keeps its own ctx.id (citations, anchors, the search index).
 */
import type { Block } from '../../lib/blocks';
import type { BlockCtx } from '../../lib/blocks-ctx';
import type { RunRenderer } from '../../lib/features';
import WalkthroughPhone from '../media/WalkthroughPhone.astro';
import WalkthroughPlayer from '../media/WalkthroughPlayer.astro';
interface Props {
  blocks: Extract<Block, { t: 'feature' }>[];
  ctxs: BlockCtx[];
  renderer: RunRenderer;
}
const { blocks, ctxs, renderer } = Astro.props;
---
{renderer === 'player' ? <WalkthroughPlayer blocks={blocks} ctxs={ctxs} /> : <WalkthroughPhone blocks={blocks} ctxs={ctxs} />}
