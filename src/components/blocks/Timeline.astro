---
/**
 * Timeline · OWNER: WP4a (P0 functional stub). Phasing schedule (CSBS): her `k` above each tick, her `v` (with <br>)
 * below; an empty `v` renders as-is. No "current" marker. Plan view: keep.
 */
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { rich } from '../../lib/rich';
interface Props { block: Extract<Block, { t: 'timeline' }>; ctx: BlockCtx }
const { block, ctx } = Astro.props;
---
<div {...blkAttrs('timeline', ctx)}>
  <div class="blk__main">
    <ol class="timeline" role="list">
      {block.items.map((it) => (
        <li class="tl">
          <span class="tl__k t-label" data-v>{it.k}</span>
          <span class="tl__v t-body-sm ink-2" data-v set:html={rich(it.v)} />
        </li>
      ))}
    </ol>
  </div>
</div>
<style>
  .timeline { list-style: none; padding: 0; display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); }
  .tl { display: grid; gap: var(--s-1); align-content: start; border-block-start: var(--lw-border) solid var(--ink); padding-block-start: var(--s-2); }
</style>
