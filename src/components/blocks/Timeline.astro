---
/**
 * Timeline · WP4a (SPEC §6.2 `timeline`): CSBS's summer as a phasing schedule.
 * Horizontal: a --lw-border ink baseline with a tick at each (evenly spaced) phase; her `k` ("Week 2") in label caps
 * above the tick, her `v` (her <br> kept) in Newsreader ≈ 15px ink-2 below. "Onboarding" has an empty `v`, rendered
 * as-is. No "current" marker: the timeline is historical.
 * The layout follows the space it actually has (a container query, not the viewport): one row of phases only when
 * every phase gets ≥ 130px (a container ≥ 1300px — wider than today's widest track, 968px, so her 2-line values never
 * stack 4–6 deep), two rows of five from 560px (tablets and every desktop width) read as ONE track through a drafting
 * continuation (row 1's baseline runs into a clay arrowhead; a matching clay arrow leads row 2 onto its first tick),
 * and a vertical track below that (phones). Plan view: keep.
 */
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { rich } from '../../lib/rich';
interface Props { block: Extract<Block, { t: 'timeline' }>; ctx: BlockCtx }
const { block, ctx } = Astro.props;
const n = block.items.length;
const half = Math.ceil(n / 2);
---
<div {...blkAttrs('timeline', ctx)}>
  <div class="blk__main tl-c">
    <ol class="timeline" role="list" style={`--_n: ${n}; --_half: ${half}`}>
      {block.items.map((it, i) => (
        <li class:list={['tl', { 'tl--row-end': i === half - 1 && i !== n - 1, 'tl--row-start': i === half && i > 0, 'tl--end': i === n - 1 }]}>
          <p class="tl__k" data-v>{it.k}</p>
          <span class="tl__tick" aria-hidden="true"></span>
          <p class="tl__v" data-v set:html={rich(it.v)} />
        </li>
      ))}
    </ol>
  </div>
</div>
<style>
  .tl-c { container-type: inline-size; }
  .timeline {
    --_tick: var(--s-3);           /* tick height */
    --_row: calc(var(--fs-caption) * var(--lh-caption));   /* vertical track: one line of her value (= the key's line) */
    --_ky: calc(var(--fs-label) * var(--lh-label) + var(--s-2));   /* horizontal: the tick band's top (under the key) */
    --_ah: calc(var(--s-2) - var(--lw-object));             /* the continuation arrowhead (7px) */
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .tl__k {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: var(--wt-label);
    line-height: var(--lh-label);
    letter-spacing: var(--tr-label);
    font-variation-settings: var(--wdth-label);
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  .tl__v {
    font-family: var(--font-serif);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--ink-2);
    text-wrap: pretty;
    hyphens: manual;
  }

  /* ── vertical track (phones): the line runs down the left, a tick per phase ── */
  .tl {
    position: relative;
    display: grid;
    grid-template-columns: calc(var(--s-9) - var(--s-2)) minmax(0, 1fr);   /* 88px key column */
    column-gap: var(--s-4);
    align-items: start;             /* the key takes her value's line height (below): both first lines share one centre */
    padding-block: var(--s-2) var(--s-3);
    padding-inline-start: var(--s-5);
  }
  .tl:first-child { padding-block-start: 0; }
  .tl:last-child { padding-block-end: 0; }
  /* the spine: each phase draws its run, from its tick (first) / its top (others) to the next phase / its tick (last) */
  .tl::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block: 0;
    border-inline-start: var(--lw-border) solid var(--ink);
  }
  /* (the line metrics are spelled out: an `lh` on the tick or the pseudo-elements would resolve on the body line) */
  .tl:first-child::before { inset-block-start: calc(var(--_row) / 2); }
  .tl:last-child::before { inset-block-end: auto; block-size: calc(var(--s-2) + var(--_row) / 2); }
  .tl:only-child::before { content: none; }
  .tl__tick {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: calc(var(--s-2) + var(--_row) / 2);
    inline-size: var(--s-3);
    border-block-start: var(--lw-object) solid var(--ink);
  }
  @container (max-width: 559.98px) {
    .tl__k { line-height: var(--_row); }
    .tl:first-child .tl__tick { inset-block-start: calc(var(--_row) / 2); }
  }
  .tl__k { grid-column: 1; }
  .tl__v { grid-column: 2; }

  /* ── horizontal: two rows (≥ 560px) or one row (≥ 1300px: ≥ 130px a phase, her values stay 1–2 lines) ── */
  @container (min-width: 560px) {
    .timeline { grid-template-columns: repeat(var(--_half), minmax(0, 1fr)); row-gap: var(--s-6); }
    .tl {
      display: flex;
      flex-direction: column;
      padding: 0;
      border: 0;
    }
    .tl::before { content: none; }
    .tl:first-child, .tl:last-child { padding: 0; }
    .tl__k { order: 0; padding-inline: var(--s-1) 0; padding-block-end: var(--s-2); }
    /* the baseline: each phase draws its own run of it, so the runs join into one line */
    .tl__tick {
      order: 1;
      position: relative;
      inset: auto;
      display: block;
      inline-size: 100%;
      block-size: var(--_tick);
      border-block-start: 0;
    }
    .tl__tick::before {       /* the baseline run */
      content: '';
      position: absolute;
      inset-inline: 0;
      inset-block-start: 50%;
      border-block-start: var(--lw-border) solid var(--ink);
    }
    .tl__tick::after {        /* the tick at the phase's start */
      content: '';
      position: absolute;
      inset-inline-start: 0;
      inset-block: 0;
      border-inline-start: var(--lw-object) solid var(--ink);
    }
    .tl__v { order: 2; padding: var(--s-2) var(--s-2) 0 var(--s-1); text-wrap: balance; }   /* even breaks in narrow phases */
    /* the end of the schedule closes the baseline with its own tick */
    .tl--end::after {
      content: '';
      position: absolute;
      inset-inline-end: 0;
      inset-block-start: var(--_ky);
      block-size: var(--_tick);
      border-inline-end: var(--lw-object) solid var(--ink);
    }
    /* two rows are ONE track: the first row's baseline runs on into a clay arrowhead (continued), and the second row
       is led in by a matching clay arrow onto its first tick — a drafting continuation, chrome only (pseudo-elements) */
    .tl--row-end::after,
    .tl--row-start::after {
      content: '';
      position: absolute;
      inset-block-start: calc(var(--_ky) + (var(--_tick) - var(--_ah)) / 2);
      inline-size: var(--_ah);
      block-size: var(--_ah);
      border-block-start: var(--lw-border) solid var(--clay);
      border-inline-end: var(--lw-border) solid var(--clay);
      transform: rotate(45deg);
    }
    /* a square turned 45°: its tip lies ≈ 0.71 × side from its centre — the tips land on the row's end / on the tick */
    .tl--row-end::after { inset-inline-end: calc(var(--_ah) * 0.21 + var(--lw-border)); }
    .tl--row-start::after { inset-inline-start: calc(var(--_ah) * -1.21 - var(--lw-border)); }
    .tl--row-start::before {   /* the lead-in, hanging in the margin (the chapter's painted box takes the gutter in) */
      content: '';
      position: absolute;
      inset-inline-start: calc(-1 * min(var(--s-5), var(--m) - var(--s-1)));
      inline-size: min(var(--s-5), var(--m) - var(--s-1));
      inset-block: calc(var(--_ky) + var(--_tick) / 2) auto;
      border: 0;
      border-block-start: var(--lw-border) solid var(--clay);
    }
  }
  @container (min-width: 1300px) {
    /* one row: evenly spaced; min-content only as a safety net for a longer word than today's */
    .timeline { grid-template-columns: repeat(var(--_n), minmax(min-content, 1fr)); }
    .tl--row-end::after, .tl--row-start::after, .tl--row-start::before { content: none; }
  }
</style>
