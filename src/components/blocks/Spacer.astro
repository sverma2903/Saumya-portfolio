---
/** Spacer · WP4a (SPEC §6.2 `spacer`). A 64px band of vellum; purely spatial (aria-hidden). Plan view: omit. */
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
interface Props { block: Extract<Block, { t: 'spacer' }>; ctx: BlockCtx }
const { ctx } = Astro.props;
---
<div {...blkAttrs('spacer', ctx)} aria-hidden="true"><div class="blk__main spacer"></div></div>
<style>
  .spacer { block-size: var(--s-8); }
</style>
