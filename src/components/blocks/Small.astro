---
/**
 * Small · WP4a (SPEC §6.2 `small`). <p class="small" data-v> in the notes column (.blk__note) at ≥ 1280px, below its
 * predecessor otherwise; --fs-caption, upright, ink-2. Not used by the current content, but supported.
 * Plan view: like `p` (skim to her bold, or omitted by the Chapter).
 */
import Icon from '../symbols/Icon.astro';
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { rich } from '../../lib/rich';
interface Props { block: Extract<Block, { t: 'small' }>; ctx: BlockCtx }
const { block, ctx } = Astro.props;
const skim = ctx.plan.mode === 'skim' ? (ctx.plan.skim ?? []) : null;
---
<div {...blkAttrs('small', ctx)}>
  <div class="blk__note">
    <p class:list={['small', { full: !!skim }]} data-v set:html={rich(block.html)} />
    {skim && (
      <p class="small skim">{skim.map((s, i) => (
        <>{i > 0 && <span class="small__join" aria-hidden="true" data-chrome data-join><Icon name="ellipsis" /></span>}<strong data-v set:html={s} /></>
      ))}</p>
    )}
  </div>
</div>
<style>
  .small {
    font-family: var(--font-serif);
    font-size: var(--fs-caption);
    font-weight: var(--wt-caption);
    line-height: var(--lh-caption);
    letter-spacing: var(--tr-caption);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .small__join { display: inline-block; margin-inline: 0.3em; color: var(--clay); vertical-align: -0.06em; }
  .small__join :global(.icon) { inline-size: 1em; block-size: 1em; }
</style>
