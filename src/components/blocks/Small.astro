---
/**
 * Small · OWNER: WP4a (P0 functional stub). <p class="small" data-v> in the notes column (≥1280), caption style,
 * upright, ink-2. Plan view: like `p`. (Not used by the current content, but supported.)
 */
import type { Block } from '../../lib/blocks';
import { blkAttrs, type BlockCtx } from '../../lib/blocks-ctx';
import { rich } from '../../lib/rich';
interface Props { block: Extract<Block, { t: 'small' }>; ctx: BlockCtx }
const { block, ctx } = Astro.props;
const skim = ctx.plan.mode === 'skim' ? (ctx.plan.skim ?? []) : null;
---
<div {...blkAttrs('small', ctx)}>
  <div class="blk__note">
    <p class:list={['small', 't-body-sm', 'ink-2', { full: !!skim }]} data-v set:html={rich(block.html)} />
    {skim && <p class="small skim t-body-sm ink-2">{skim.map((s, i) => <>{i > 0 && <span data-chrome aria-hidden="true"> ⋯ </span>}<strong data-v set:html={s} /></>)}</p>}
  </div>
</div>
