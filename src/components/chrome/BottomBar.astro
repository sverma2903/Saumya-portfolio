---
/**
 * BottomBar · WP1. The thumb-reachable title bar below 1024px (SPEC §4.2):
 *   ▔▔▔▔▔▔▔ (2px rust scroll progress on its top edge)
 *   [ △○□ ] │ [ ▼ IDEATE  ▴ ]  or  [ MENU ▴ ] │ [ RESUME ↗ ]
 * - the mark → / (cover sheet); the centre cell opens the drawer (Drawer.astro) — "MENU" on Home/About/Play/404,
 *   the current level on cases (live from WP5's `sv:level`; the first level until then);
 * - her Resume ↗ (polish r1; it replaced the sheet number, so the number rolls only in the title bar, ≥ 1024);
 * - every target ≥ 48 × 48; safe-area aware; the no-JS centre cell is a plain link to /#index.
 */
import type { PageMeta } from '../../lib/page';
import { chrome } from '../../data/chrome';
import { labels, links } from '../../content/site';
import { externalAttrs } from '../../lib/rich';
import Icon from '../symbols/Icon.astro';
import Mark from '../symbols/Mark.astro';
import Datum from '../symbols/Datum.astro';
import Drawer from './Drawer.astro';
interface Props { page: PageMeta }
const { page } = Astro.props;
const t = chrome.wp1.bottomBar;
const first = page.kind === 'case' ? page.levels?.[0] : undefined;
---
<nav class="bottombar" aria-label={t.label} data-bottombar>
  <span class="bottombar__progress" aria-hidden="true"><span data-progress></span></span>
  <a class="bottombar__home" href="/" aria-label={t.home}><Mark size={24} strokeWidth={1.15} /></a>
  <button type="button" class="bottombar__centre" data-drawer-open aria-haspopup="dialog" aria-expanded="false" aria-controls="sv-drawer" data-js-only>
    {first ? (
      <span class="bottombar__level">
        <Datum size={10} />
        <span class="sr-only">{t.level} </span><span class="bottombar__label t-label-lg" data-level-label data-v>{first.label}</span>
      </span>
    ) : (
      <span class="bottombar__sheets t-label-lg">{t.sheets}</span>
    )}
    <svg class="bottombar__caret" width="9" height="6" viewBox="0 0 9 6" aria-hidden="true" focusable="false"><path d="M0.8 5.4 4.5 0.8l3.7 4.6" fill="none" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" /></svg>
  </button>
  <a class="bottombar__centre bottombar__centre--nojs t-label-lg" href="/#index">{t.sheets}</a>
  <a class="bottombar__resume t-label-lg" href={links.resume} {...externalAttrs(links.resume)}><span data-v>{labels.nav.resume}</span><Icon name="arrow-up-right" size={13} /></a>
</nav>
<Drawer page={page} />

<script>
  import { listen } from '../../scripts/core/bus';
  import { rafThrottle } from '../../scripts/core/dom';

  const bar = document.querySelector<HTMLElement>('[data-bottombar]');
  const fill = bar?.querySelector<HTMLElement>('[data-progress]');
  const narrow = matchMedia('(max-width: 1023.98px)');

  // 2px rust progress hairline: scroll position through the page (only measured while the bar is shown)
  const paint = rafThrottle(() => {
    if (!fill || !narrow.matches) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    fill.style.transform = `scaleX(${p.toFixed(4)})`;
  });
  addEventListener('scroll', paint, { passive: true });
  addEventListener('resize', paint, { passive: true });
  narrow.addEventListener('change', paint);
  paint();

  // the live level (cases): ▼ LABEL
  const label = bar?.querySelector<HTMLElement>('[data-level-label]');
  if (label) {
    listen('sv:level', (d) => {
      if (!d || typeof d.label !== 'string' || !d.label) return;
      if (label.textContent !== d.label) label.textContent = d.label;
    });
  }
</script>

<style>
  .bottombar {
    position: fixed; inset-inline: 0; inset-block-end: 0; z-index: var(--z-bar);
    display: grid; grid-template-columns: var(--bar) minmax(0, 1fr) auto; align-items: stretch;
    block-size: calc(var(--bar) + env(safe-area-inset-bottom)); padding-block-end: env(safe-area-inset-bottom);
    padding-inline: env(safe-area-inset-left) env(safe-area-inset-right);
    background: var(--sheet); border-block-start: var(--lw-border) solid var(--ink);
    /* its own group in the page cut (transitions.css): cut like the page, but above a morphing plate */
    view-transition-name: vt-bottombar;
  }
  /* the progress hairline sits on the ink edge */
  .bottombar__progress {
    position: absolute; inset-inline: 0; inset-block-start: calc(-1 * var(--lw-border)); block-size: var(--lw-cut); overflow: hidden; pointer-events: none;
  }
  .bottombar__progress > span {
    display: block; block-size: 100%; background: var(--rust);
    transform: scaleX(0); transform-origin: 0 50%;
  }

  .bottombar__home {
    display: grid; place-items: center; min-inline-size: var(--s-7); min-block-size: var(--s-7); color: var(--rust);
    border-inline-end: var(--lw-object) solid var(--line-2);
  }
  .bottombar__home:hover { color: var(--rust-deep); }
  .bottombar__home:focus-visible, .bottombar__centre:focus-visible { outline-offset: calc(-1 * var(--s-1)); }

  .bottombar__centre {
    display: flex; align-items: center; justify-content: center; gap: var(--s-3);
    min-inline-size: 0; min-block-size: var(--s-7); padding-inline: var(--s-4);
    color: var(--ink); text-decoration: none; white-space: nowrap;
  }
  .bottombar__centre:hover { color: var(--rust-deep); }
  .bottombar__centre:active { background: var(--paper-2); }
  :global(html.js) .bottombar__centre--nojs { display: none; }
  .bottombar__level { display: inline-flex; align-items: center; gap: var(--s-2); min-inline-size: 0; }
  .bottombar__level :global(.sym-datum) { color: var(--rust); }
  .bottombar__label { overflow: hidden; text-overflow: ellipsis; }
  .bottombar__caret { flex: none; color: var(--ink-2); }
  .bottombar__centre[aria-expanded='true'] .bottombar__caret { transform: rotate(180deg); }

  /* polish r1: the right cell is her Resume ↗ (what a recruiter looks for on a phone), where the sheet number repeated
     what the mark's cell already links to */
  .bottombar__resume {
    display: flex; align-items: center; gap: var(--s-1); padding-inline: var(--s-4) var(--m); min-block-size: var(--s-7);
    border-inline-start: var(--lw-object) solid var(--line-2);
    color: var(--ink); text-decoration: none; white-space: nowrap;
  }
  .bottombar__resume :global(.icon) { color: var(--ink-2); }
  .bottombar__resume:hover { color: var(--rust-deep); }
  .bottombar__resume:focus-visible { outline-offset: calc(-1 * var(--s-1)); }
  @media (max-width: 339.98px) {
    .bottombar__centre { padding-inline: var(--s-3); gap: var(--s-2); }
    .bottombar__resume { padding-inline: var(--s-3); }
  }
  @media (min-width: 1024px) { .bottombar { display: none; } }
  @media print { .bottombar { display: none; } }
</style>
