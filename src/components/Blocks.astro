---
import type { Block } from '../lib/blocks';
import Frame from './Frame.astro';
import Media from './Media.astro';

interface Props {
  blocks: Block[];
  alt?: string;
}
const { blocks, alt = '' } = Astro.props;
const strip = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').trim();
const isExternal = (href: string) => /^https?:/.test(href);
---
{blocks.map((b) => {
  switch (b.t) {
    case 'h':
      return <h3 class="b b-h" data-reveal>{b.text}</h3>;
    case 'h3':
      return <h4 class="b b-h3" data-reveal set:html={b.html} />;
    case 'lede':
      return <p class:list={['b b-lede', b.size]} data-split set:html={b.html} />;
    case 'p':
      return <p class:list={['b b-p', b.size]} data-reveal set:html={b.html} />;
    case 'small':
      return <p class="b b-small" data-reveal set:html={b.html} />;
    case 'list':
      return (
        <ul class:list={['b b-list', { numbered: b.numbered }]} data-reveal>
          {b.items.map((i) => <li set:html={i} />)}
        </ul>
      );
    case 'media':
      return (
        <figure class:list={['b b-media', { wide: b.wide }]} style={`--cols: ${b.cols ?? 1}`} data-reveal>
          {b.items.map((m) => (
            <Frame media={m} frame={b.frame} alt={b.caption ? strip(b.caption) : alt} zoom={b.zoom ?? true} />
          ))}
          {b.caption && <figcaption set:html={b.caption} />}
        </figure>
      );
    case 'stats':
      return (
        <div class="b b-stats" data-reveal>
          {b.items.map((s) => (
            <div class="stat">
              <div class="v" data-count set:html={s.v} />
              <p class="l" set:html={s.html} />
            </div>
          ))}
        </div>
      );
    case 'cta':
      return (
        <div class="b b-cta" data-reveal>
          {b.items.map((c, i) => (
            <a
              class:list={['btn', { solid: i === 0 }]}
              href={c.href}
              target={isExternal(c.href) ? '_blank' : undefined}
              rel={isExternal(c.href) ? 'noopener' : undefined}
              data-magnetic
            >
              {c.label} <span class="arrow">{isExternal(c.href) ? '↗' : '↓'}</span>
            </a>
          ))}
        </div>
      );
    case 'callout':
      return (
        <aside class="b b-callout" data-reveal>
          <span class="tag mono">{b.title}</span>
          <p class="lede" set:html={b.lede} />
          <p set:html={b.html} />
        </aside>
      );
    case 'cards':
      return (
        <div class:list={['b b-cards', b.variant ?? 'plain']} style={`--cols: ${b.cols ?? 3}`} data-reveal>
          {b.items.map((c) => (
            <article class="card">
              {c.img && (
                <div class="card-img">
                  <Media media={c.img} alt="" />
                </div>
              )}
              {c.kicker && <span class="kicker mono">{c.kicker}</span>}
              <h4 set:html={c.title} />
              {c.html && <p set:html={c.html} />}
            </article>
          ))}
        </div>
      );
    case 'feature':
      return (
        <div class:list={['b b-feature', { flip: b.flip, solo: !b.media.length }]}>
          <div class="f-text" data-reveal>
            {b.n && <span class="f-n">{b.n}</span>}
            {b.kicker && <span class="f-kicker mono">{b.kicker}</span>}
            {b.title && <h4 class="f-title" set:html={b.title} />}
            {b.lede && <p class="f-lede" set:html={b.lede} />}
            {b.html && <p set:html={b.html} />}
            {b.items && (
              <ul class="b-list">
                {b.items.map((i) => <li set:html={i} />)}
              </ul>
            )}
          </div>
          {b.media.length > 0 && (
            <div class="f-media" data-reveal>
              {b.media.map((m) => <Frame media={m} alt={strip(b.title ?? b.lede ?? '')} />)}
            </div>
          )}
        </div>
      );
    case 'stories':
      return (
        <div class="b b-stories" data-reveal>
          {b.items.map((s) => (
            <article class="story">
              <Media media={s.img} alt={s.title} />
              <div>
                <h4>{s.title}</h4>
                <dl>
                  {s.rows.map(([k, v]) => (
                    <div>
                      <dt>{k}</dt>, <dd>{v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </article>
          ))}
        </div>
      );
    case 'timeline':
      return (
        <div class="b b-timeline" data-reveal>
          <ol>
            {b.items.map((i) => (
              <li>
                <div class="k mono">{i.k}</div>
                <div class="v" set:html={i.v} />
              </li>
            ))}
          </ol>
        </div>
      );
    case 'insights':
      return (
        <div class="b b-insights">
          {b.items.map((i) => (
            <article class="insight" data-reveal>
              <div>
                <h4 set:html={i.title} />
                {i.sub && <p class="sub" set:html={i.sub} />}
                <ul class="b-list">
                  {i.items.map((x) => <li set:html={x} />)}
                </ul>
              </div>
              {i.img && <Frame media={i.img} alt={strip(i.title)} />}
            </article>
          ))}
        </div>
      );
    case 'split':
      return (
        <div class="b b-split" style={b.ratio ? `--ratio: ${b.ratio}` : undefined}>
          <div>
            <Astro.self blocks={b.left} alt={alt} />
          </div>
          <div>
            <Astro.self blocks={b.right} alt={alt} />
          </div>
        </div>
      );
    case 'tabs':
      return (
        <div class="b b-tabs" data-tabs data-reveal>
          <div role="tablist" aria-label="Personas">
            {b.items.map((t, i) => (
              <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                {t.label}
              </button>
            ))}
          </div>
          {b.items.map((t, i) => (
            <div role="tabpanel" hidden={i !== 0}>
              <Frame media={t.media} alt={`${t.label} persona`} />
            </div>
          ))}
        </div>
      );
    case 'concept':
      return (
        <div class="b b-concept" data-reveal>
          <h4 set:html={b.title} />
          <div class="cols" style={`--cols: ${b.media.length}`}>
            {b.media.map((m, i) => (
              <figure>
                <Frame media={m} alt={strip(b.captions[i] ?? b.title)} />
                {b.captions[i] && <figcaption set:html={b.captions[i]} />}
              </figure>
            ))}
          </div>
          {b.analysis && (
            <details>
              <summary>Concept Analysis</summary>
              <ul>
                {b.analysis.map((a) => (
                  <li class={a.trim().startsWith('+') ? 'pro' : 'con'} set:html={a} />
                ))}
              </ul>
            </details>
          )}
        </div>
      );
    default:
      return null;
  }
})}
